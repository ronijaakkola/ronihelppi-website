---
import type { TocHeading } from '../utils/extract-headings';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <nav class="heading-rail" aria-label="On this page" data-heading-rail>
      <ol class="heading-rail-list" role="list">
        {headings.map((heading, i) => (
          <li class="heading-rail-item">
            <a
              href={`#${heading.slug}`}
              class="heading-rail-link"
              data-rail-link={heading.slug}
            >
              <span class="heading-rail-tick" aria-hidden="true" />
              <span class="heading-rail-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="heading-rail-text">{heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  /* Left-edge article heading navigator.

     Progressive enhancement: the markup is server-rendered, so its links are
     plain fragment anchors that jump to the heading and it expands on
     hover/focus via CSS. JS adds the scroll-spy highlight of the in-view
     section and drops the focus a pointer click leaves on a link (see the
     script) so the rail collapses on mouse-leave instead of staying pinned open
     by :focus-within until the next click. Keyboard focus is left untouched.

     Shown only on wide, hover-capable viewports. On narrower or touch screens it
     stays hidden and the inline `[toc]` card (or the heading anchors) provide
     navigation instead — so the rail supplements that card rather than replacing
     it. Currently used on writing posts only. */
  .heading-rail {
    display: none;
    position: fixed;
    left: var(--gap-lg);
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    max-height: 80vh;
  }

  @media (min-width: 1200px) and (hover: hover) {
    .heading-rail {
      display: block;
    }
  }

  .heading-rail-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: var(--gap-2xs);
    list-style: none;
    max-height: 80vh;
    overflow: hidden;
    border: 0.5px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .heading-rail:hover .heading-rail-list,
  .heading-rail:focus-within .heading-rail-list {
    background: var(--color-bg);
    border-color: var(--color-border);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
    overflow-y: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .heading-rail-number,
    .heading-rail-text {
      transform: none;
    }
  }

  .heading-rail-item {
    margin: 0;
  }

  .heading-rail-link {
    display: flex;
    align-items: center;
    padding: 2px var(--gap-3xs);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .heading-rail-tick {
    flex-shrink: 0;
    /* Layout width is the ACTIVE size; inactive ticks paint at half width via
       scaleX so the grow/shrink runs on the GPU (animating `width` re-runs
       layout on every scroll-spy change) and labels align across rows. */
    width: 28px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-divider);
    transform: scaleX(0.5);
    transform-origin: left center;
    transition:
      transform 0.2s var(--ease-out),
      background-color 0.25s ease;
  }

  /* The section number ("01", "02" …), mirroring the inline TOC. Like the text
     it is clipped away when collapsed and revealed on hover/focus. */
  /* The label reveal. Width/margin never animate per-frame — they SNAP (0s
     duration) so the scroll-spy layout stays cheap. The visible motion is
     opacity + a small translateX slide, entirely on the GPU. What makes both
     directions feel smooth is *when* the snap fires, set by direction-aware
     transition-delay:

       Open (the :hover/:focus-within rules below): width/margin snap open
       immediately (0s delay) so the panel is full width at once, then the label
       fades/slides in.

       Close (this base rule): the label fades/slides out first, and the
       width/margin snap to 0 is held back by a delay equal to the fade. By the
       time layout collapses, the label is already at opacity 0 — so the reset
       is invisible and the eye only ever sees a clean fade-out, never a clip.

     prefers-reduced-motion drops all of this to an instant snap (see below). */
  .heading-rail-number {
    flex-shrink: 0;
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-4px);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    letter-spacing: var(--tracking-small);
    line-height: 1.4;
    color: var(--color-text-secondary);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      max-width 0s linear 0.2s,
      margin-left 0s linear 0.2s;
  }

  .heading-rail:hover .heading-rail-number,
  .heading-rail:focus-within .heading-rail-number {
    max-width: 3ch;
    margin-left: var(--gap-2xs);
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      max-width 0s linear 0s,
      margin-left 0s linear 0s;
  }

  .heading-rail-text {
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateX(-4px);
    font-family: var(--font-sans);
    font-size: var(--text-code);
    letter-spacing: var(--tracking-small);
    line-height: 1.4;
    color: inherit;
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      max-width 0s linear 0.2s,
      margin-left 0s linear 0.2s;
  }

  .heading-rail:hover .heading-rail-text,
  .heading-rail:focus-within .heading-rail-text {
    max-width: 220px;
    margin-left: var(--gap-2xs);
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      max-width 0s linear 0s,
      margin-left 0s linear 0s;
  }

  /* In-view section (the scroll-spy script sets aria-current="location").
     The active line turns white and gently grows in length. */
  .heading-rail-link[aria-current='location'] {
    color: var(--color-text-primary);
  }

  .heading-rail-link[aria-current='location'] .heading-rail-tick {
    transform: scaleX(1);
    background: var(--color-text-primary);
  }

  /* Match the site's hover/focus feedback convention */
  .heading-rail-link:hover,
  .heading-rail-link:focus-visible {
    color: var(--color-text-primary);
  }

  .heading-rail-link:hover .heading-rail-tick,
  .heading-rail-link:focus-visible .heading-rail-tick {
    background: var(--color-text-primary);
  }

  .heading-rail-link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .heading-rail-list,
    .heading-rail-tick,
    .heading-rail-number,
    .heading-rail-text {
      transition: none;
    }
  }
</style>

<script>
  import { pickActiveHeadingId, type HeadingPosition } from '../utils/heading-rail';

  // Roughly the reading focus line: a section becomes "current" once its heading
  // has scrolled to within this many pixels of the viewport top. The header is
  // not sticky on desktop, so a small offset is enough.
  const ACTIVATION_OFFSET = 140;

  interface TrackedHeading {
    id: string;
    heading: HTMLElement;
    link: HTMLAnchorElement;
  }

  let cleanup: (() => void) | null = null;
  const pageLoadHandlerKey = '__headingRailPageLoadHandler__';

  function initHeadingRail() {
    // Tear down listeners from the previous page (the DOM is swapped on
    // View Transitions navigation, so old element references are stale).
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const rail = document.querySelector<HTMLElement>('[data-heading-rail]');
    if (!rail) return;

    // The rail expands via CSS on :hover and :focus-within. A pointer click on a
    // jump link focuses that link, and :focus-within would then keep the rail
    // expanded even after the pointer leaves — until the next click elsewhere
    // blurs it. So after a pointer-driven activation, drop the focus. Keyboard
    // activation (Enter/Space) reports detail === 0, so its focus is preserved
    // and keyboard users keep the rail open. `focus-visible` heuristics are not
    // relied on: only the pointer path is affected.
    function onRailClick(event: MouseEvent) {
      if (event.detail === 0) return; // keyboard-activated click: keep focus
      const link =
        event.target instanceof Element
          ? event.target.closest<HTMLElement>('[data-rail-link]')
          : null;
      link?.blur();
    }
    rail.addEventListener('click', onRailClick);

    const links = Array.from(
      rail.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')
    );
    const tracked: TrackedHeading[] = [];
    for (const link of links) {
      const id = link.dataset.railLink;
      const heading = id ? document.getElementById(id) : null;
      if (id && heading) tracked.push({ id, heading, link });
    }
    if (tracked.length === 0) {
      // Still tear down the click handler we just attached (blur behaviour needs
      // no tracked headings, but we must not leak the listener).
      cleanup = () => rail.removeEventListener('click', onRailClick);
      return;
    }

    let activeId: string | null = null;
    function setActive(id: string | null) {
      if (id === activeId) return;
      activeId = id;
      for (const item of tracked) {
        if (item.id === id) item.link.setAttribute('aria-current', 'location');
        else item.link.removeAttribute('aria-current');
      }
    }

    let ticking = false;
    function update() {
      ticking = false;
      const positions: HeadingPosition[] = tracked.map((item) => ({
        id: item.id,
        top: item.heading.getBoundingClientRect().top,
      }));
      // At the bottom of the page the final section may be too short to have
      // scrolled its heading up to the activation line — force it active there.
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      setActive(pickActiveHeadingId(positions, ACTIVATION_OFFSET, atBottom));
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      rail.removeEventListener('click', onRailClick);
    };
  }

  initHeadingRail();

  const previousPageLoadHandler = (window as typeof window & {
    [pageLoadHandlerKey]?: () => void;
  })[pageLoadHandlerKey];
  if (previousPageLoadHandler) {
    document.removeEventListener('astro:page-load', previousPageLoadHandler);
  }

  (window as typeof window & {
    [pageLoadHandlerKey]?: () => void;
  })[pageLoadHandlerKey] = initHeadingRail;

  document.addEventListener('astro:page-load', initHeadingRail);
</script>
