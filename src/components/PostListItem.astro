---
interface Props {
  title: string;
  date: Date;
  href: string;
  description?: string;
  layout?: 'vertical' | 'row';
  dateFormat?: 'long' | 'short';
}

const { title, date, href, description, layout = 'vertical', dateFormat = 'long' } = Astro.props;

const formattedDate = dateFormat === 'short'
  ? `${String(date.getMonth() + 1).padStart(2, '0')} / ${date.getFullYear()}`
  : date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
const isoDate = date.toISOString().split('T')[0];
---

<a href={href} aria-label={title} class:list={['post-item', { 'post-item--row': layout === 'row' }]}>
  <div class="post-header">
    <time class="post-date" datetime={isoDate}>{formattedDate}</time>
    <span class="post-title">{title}</span>
  </div>
  {description && <p class="post-description">{description}</p>}
</a>

<style>
  .post-item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    position: relative;
    padding: var(--gap-2xs) var(--gap-xs);
    margin-block: calc(-1 * var(--gap-2xs));
    margin-inline: calc(-1 * var(--gap-xs));
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  /* Offset padding to preserve list spacing; 8px per side fits the 16px row gap. */
  .post-item::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
    background: var(--color-surface-hover);
    opacity: 0;
    pointer-events: none;
  }

  .post-item:focus-visible::before {
    opacity: 1;
  }

  .post-item:focus-visible .post-title {
    text-decoration-color: var(--color-text-primary);
  }

  @media (hover: hover) {
    .post-item:hover::before {
      opacity: 1;
    }

    .post-item:hover .post-title {
      text-decoration-color: var(--color-text-primary);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-item::before {
      transition: opacity 120ms var(--ease-out);
    }
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .post-date {
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
  }

  .post-title {
    width: fit-content;
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
    text-decoration-line: underline;
    text-decoration-color: var(--color-text-secondary);
    text-underline-offset: 2px;
  }

  .post-description {
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
  }

  /* Row layout variant */
  .post-item--row .post-header {
    flex-direction: row;
    align-items: baseline;
    gap: 0;
  }

  .post-item--row .post-date {
    flex-shrink: 0;
    min-width: 115px;
  }
</style>
