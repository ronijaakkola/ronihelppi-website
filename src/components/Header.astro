---
import KeyboardShortcut from './KeyboardShortcut.astro';
---

<header class="header">
  <nav class="nav">
    <div class="logo-breadcrumb">
      <a href="/" class="logo">Roni Helppi</a>
      <span class="breadcrumb" id="breadcrumb"></span>
    </div>

    <div class="nav-links">
      <a href="/now" class="nav-link">Now</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/posts" class="nav-link">Posts</a>
    </div>

    <a href="/contact" class="contact-button">
      <span>Contact</span>
      <KeyboardShortcut key="C" />
    </a>

    <button class="menu-button" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    width: 100%;
    padding: 0 355px;
    overflow: hidden;
    view-transition-name: header;
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 976px;
    min-height: 1px;
    overflow: hidden;
  }

  .logo {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
  }

  .breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
  }

  .breadcrumb:empty {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .contact-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: -0.6px;
    color: var(--color-button-text);
    text-decoration: none;
    grid-column: 3;
    justify-self: end;
  }

  .contact-button:hover {
    text-decoration: none;
  }

  .menu-button {
    display: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text-primary);
    grid-column: 3;
    justify-self: end;
  }

  /* Tablet */
  @media (max-width: 960px) {
    .header {
      padding: 0 var(--spacing-horizontal-tablet);
    }

    .nav {
      width: 100%;
    }
  }

  /* Phone */
  @media (max-width: 600px) {
    .header {
      padding: 0 var(--spacing-horizontal-phone);
    }

    .nav-links {
      display: none;
    }

    .contact-button {
      display: none;
    }

    .menu-button {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    const activeElement = document.activeElement as HTMLElement | null;
    if (activeElement?.tagName === 'INPUT') return;
    if (activeElement?.tagName === 'TEXTAREA') return;
    if (activeElement?.isContentEditable) return;

    if (e.key === 'c' || e.key === 'C') {
      window.location.href = '/contact';
    }
  });

  function updateBreadcrumb() {
    const breadcrumb = document.getElementById('breadcrumb');
    if (!breadcrumb) return;

    const pathname = window.location.pathname;

    // No breadcrumb on home page
    if (pathname === '/') {
      breadcrumb.textContent = '';
      return;
    }

    // Get the first segment of the path
    const segments = pathname.split('/').filter(Boolean);
    if (segments.length === 0) {
      breadcrumb.textContent = '';
      return;
    }

    // Capitalize first letter of the section
    const section = segments[0];
    const sectionName = section.charAt(0).toUpperCase() + section.slice(1);

    breadcrumb.textContent = `/ ${sectionName}`;
  }

  // Update on initial load
  updateBreadcrumb();

  // Update on view transitions (for Astro's view transitions)
  document.addEventListener('astro:page-load', updateBreadcrumb);
</script>
