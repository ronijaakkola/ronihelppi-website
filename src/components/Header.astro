---
import KeyboardShortcut from './KeyboardShortcut.astro';
---

<header class="header">
  <div class="nav">
    <nav class="logo-breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="logo" aria-label="Roni Helppi, home">Roni Helppi</a>
      <span class="breadcrumb-separator" id="breadcrumb-separator" aria-hidden="true"></span>
      <a href="/" class="breadcrumb" id="breadcrumb"></a>
    </nav>

    <nav class="nav-links" aria-label="Main">
      <a href="/about" class="nav-link">About</a>
      <a href="/projects" class="nav-link">Projects</a>
      <a href="/writing" class="nav-link">Writing</a>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
      >
        <svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12 2.5V4.5M12 19.5V21.5M4.5 12H2.5M21.5 12H19.5M5.6 5.6L7 7M17 17L18.4 18.4M18.4 5.6L17 7M7 17L5.6 18.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </button>

      <a href="/contact" class="contact-button">
        <span>Contact</span>
        <KeyboardShortcut key="C" label="Press C to go to contact page" />
      </a>
    </div>

    <button class="menu-button" id="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M13 5H21" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8 12H21" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M3 19H21" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <svg class="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6.75827 17.2426L12.0009 12M12.0009 12L17.2435 6.75736M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav class="mobile-menu-nav" aria-label="Mobile navigation">
    <a href="/" class="mobile-menu-link">Home</a>
    <a href="/about" class="mobile-menu-link">About</a>
    <a href="/projects" class="mobile-menu-link">Projects</a>
    <a href="/writing" class="mobile-menu-link">Writing</a>
    <a href="/contact" class="mobile-menu-link">Contact</a>
  </nav>
  <div class="mobile-menu-footer">
    <button
      type="button"
      class="theme-toggle mobile-theme-toggle"
      id="mobile-theme-toggle"
      aria-label="Switch to light theme"
    >
      <svg class="theme-icon theme-icon-sun" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 2.5V4.5M12 19.5V21.5M4.5 12H2.5M21.5 12H19.5M5.6 5.6L7 7M17 17L18.4 18.4M18.4 5.6L17 7M7 17L5.6 18.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <svg class="theme-icon theme-icon-moon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </button>
    <a href="/rss.xml" class="mobile-menu-rss">RSS</a>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    width: 100%;
    padding: 0 var(--spacing-horizontal-tablet);
    view-transition-name: header;
  }

  ::view-transition-old(header),
  ::view-transition-new(header),
  ::view-transition-group(header),
  ::view-transition-image-pair(header) {
    animation: none !important;
    opacity: 1 !important;
    mix-blend-mode: normal !important;
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: calc(var(--layout-width) + var(--gap-section));
    min-height: 1px;
  }

  .logo {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
    white-space: nowrap;
  }

  .breadcrumb-separator {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    opacity: 0;
    transition: opacity 0.4s ease-out;
    view-transition-name: breadcrumb-separator;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-separator {
      transition: none;
    }

    ::view-transition-old(breadcrumb-text),
    ::view-transition-old(breadcrumb-separator),
    ::view-transition-new(breadcrumb-text),
    ::view-transition-new(breadcrumb-separator) {
      animation: none;
    }

    .mobile-menu-link {
      transition: none;
      opacity: 1;
      transform: none;
    }

    .mobile-menu.open .mobile-menu-link {
      transition-delay: 0ms;
    }
  }

  .breadcrumb-separator.visible {
    opacity: 1;
  }

  .breadcrumb-separator:empty {
    display: none;
  }

  .breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    text-decoration: none;
    view-transition-name: breadcrumb-text;
  }

  /* View transition animations for breadcrumb fade-out */
  ::view-transition-old(breadcrumb-text),
  ::view-transition-old(breadcrumb-separator) {
    animation: fade-out 0.3s ease-out forwards;
  }

  ::view-transition-new(breadcrumb-text),
  ::view-transition-new(breadcrumb-separator) {
    animation: none;
  }

  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .breadcrumb:hover,
  .breadcrumb:focus-visible {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  .breadcrumb:empty {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: var(--gap-lg);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    grid-column: 3;
    justify-self: end;
  }

  /* Theme toggle (shared by desktop header and mobile menu) */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: color 150ms, background-color 150ms;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  /* Show the icon for the theme the toggle switches TO. Dark shows the sun
     (switch to light); light shows the moon (switch to dark). */
  .theme-icon-moon {
    display: none;
  }

  .theme-icon-sun {
    display: block;
  }

  :global(:root[data-theme='light']) .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .theme-icon-moon {
    display: block;
  }

  .contact-button {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
    padding: 4px 8px;
    min-height: 24px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-button-text);
    text-decoration: none;
  }

  .contact-button {
    transition: filter 150ms;
  }

  .contact-button:hover {
    text-decoration: none;
    filter: brightness(0.85);
  }

  .menu-button {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    margin: -8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-text-primary);
    grid-column: 3;
    justify-self: end;
  }

  .menu-button .close-icon {
    display: none;
  }

  .header.menu-open .menu-button .menu-icon {
    display: none;
  }

  .header.menu-open .menu-button .close-icon {
    display: block;
  }

  /* Header background when menu is open */
  .header.menu-open {
    position: relative;
    z-index: 101;
    background-color: transparent;
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    display: none;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-overlay);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    padding: calc(var(--header-height) + 72px) var(--spacing-horizontal-phone) calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu.open {
    display: block;
    opacity: 1;
    visibility: visible;
    overscroll-behavior: contain;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .mobile-menu-link {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -1.6px;
    color: var(--color-text-secondary);
    text-decoration: none;
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link:focus-visible {
    text-decoration: underline;
    color: var(--color-text-primary);
  }

  .mobile-menu-link[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .mobile-menu.open .mobile-menu-link {
    opacity: 1;
    transform: translateY(0);
  }

  /* Cascading animation delays */
  .mobile-menu.open .mobile-menu-link:nth-child(1) {
    transition-delay: 0ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(2) {
    transition-delay: 50ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(3) {
    transition-delay: 100ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(4) {
    transition-delay: 150ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(5) {
    transition-delay: 200ms;
  }

  /* Reset delays when closing */
  .mobile-menu:not(.open) .mobile-menu-link {
    transition-delay: 0ms;
  }

  /* Mobile menu footer with theme toggle and RSS link */
  .mobile-menu-footer {
    position: absolute;
    bottom: 24px;
    left: var(--spacing-horizontal-phone);
    right: var(--spacing-horizontal-phone);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-theme-toggle {
    width: 44px;
    height: 44px;
    margin-left: -10px;
    color: var(--color-text-secondary);
  }

  .mobile-menu-rss {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -1.2px;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-align: right;
  }

  .mobile-menu-rss:hover,
  .mobile-menu-rss:focus-visible {
    color: var(--color-text-primary);
  }

  /* Phone */
  @media (max-width: 600px) {
    .header {
      padding: 0 var(--spacing-horizontal-phone);
    }

    .nav-links {
      display: none;
    }

    .header-actions {
      display: none;
    }

    .menu-button {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-menu {
      display: flex;
    }
  }
</style>

<script>
  // Update active navigation state based on current URL
  function updateActiveNavLinks() {
    const pathname = window.location.pathname;

    // Get all nav links (desktop and mobile)
    const desktopLinks = document.querySelectorAll('.nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-menu-link');

    // Clear all aria-current attributes first
    desktopLinks.forEach(link => link.removeAttribute('aria-current'));
    mobileLinks.forEach(link => link.removeAttribute('aria-current'));

    // Determine the active section based on pathname
    const getActiveSection = (path: string): string => {
      if (path === '/') return '/';
      const segments = path.split('/').filter(Boolean);
      if (segments.length > 0) {
        return `/${segments[0]}`;
      }
      return '/';
    };

    const activeSection = getActiveSection(pathname);

    // Set aria-current for matching links
    const setAriaCurrentForLinks = (links: NodeListOf<Element>) => {
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (!href) return;

        // Exact match for home
        if (href === '/' && activeSection === '/') {
          link.setAttribute('aria-current', 'page');
        }
        // Section match for other pages
        else if (href !== '/' && activeSection === href) {
          link.setAttribute('aria-current', 'page');
        }
      });
    };

    setAriaCurrentForLinks(desktopLinks);
    setAriaCurrentForLinks(mobileLinks);
  }

  // Initialize active nav state
  updateActiveNavLinks();

  // Update on view transitions
  document.addEventListener('astro:after-swap', updateActiveNavLinks);
  document.addEventListener('astro:page-load', updateActiveNavLinks);

  // Mobile menu toggle functionality
  let mobileMenuAbortController: AbortController | null = null;

  function initMobileMenu() {
    // Abort previous document/window listeners to prevent accumulation
    mobileMenuAbortController?.abort();
    mobileMenuAbortController = new AbortController();
    const { signal } = mobileMenuAbortController;

    const menuButton = document.getElementById('menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.querySelector('.header');
    const menuLinks = mobileMenu?.querySelectorAll('.mobile-menu-link');

    if (!menuButton || !mobileMenu || !header) return;

    // Store references to avoid TypeScript null warnings in nested functions
    const menu = mobileMenu;
    const btn = menuButton;
    const hdr = header;

    function openMenu() {
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      hdr.classList.add('menu-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      document.body.classList.add('scroll-lock');
      // Trap focus: make main content inert so focus stays in menu
      const mainContent = document.querySelector('main');
      if (mainContent) mainContent.setAttribute('inert', '');
    }

    function closeMenu() {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      hdr.classList.remove('menu-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      document.body.classList.remove('scroll-lock');
      // Release focus trap
      const mainContent = document.querySelector('main');
      if (mainContent) mainContent.removeAttribute('inert');
    }

    function toggleMenu() {
      const isOpen = menu.classList.contains('open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Toggle on button click
    btn.addEventListener('click', toggleMenu);

    // Close on link click
    menuLinks?.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key (uses signal to prevent listener accumulation)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
        btn.focus();
      }
    }, { signal });

    // Close menu on resize to desktop (uses signal to prevent listener accumulation)
    window.addEventListener('resize', () => {
      if (window.innerWidth > 600 && menu.classList.contains('open')) {
        closeMenu();
      }
    }, { signal });
  }

  // Initialize on page load
  initMobileMenu();

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:after-swap', initMobileMenu);

  // Theme toggle: the palette itself is applied by the inline script in
  // BaseLayout (which owns localStorage + View Transition reapplication).
  // Here we only wire the controls and keep their labels in sync. The Header
  // is transition:persist, so this runs once and the buttons/listeners persist.
  interface ThemeWindow extends Window {
    __getTheme?: () => 'light' | 'dark';
    __setTheme?: (theme: 'light' | 'dark') => void;
  }

  function initThemeToggle() {
    const w = window as ThemeWindow;

    const getTheme = (): 'light' | 'dark' => w.__getTheme?.() ?? 'dark';
    const labelFor = (theme: 'light' | 'dark') =>
      theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme';

    const sync = (theme: 'light' | 'dark') => {
      document
        .querySelectorAll<HTMLButtonElement>('.theme-toggle')
        .forEach((btn) => btn.setAttribute('aria-label', labelFor(theme)));
    };

    // Event delegation on document survives both transition:persist and full
    // DOM swaps, so the control keeps working after any navigation.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('.theme-toggle')) return;
      w.__setTheme?.(getTheme() === 'light' ? 'dark' : 'light');
    });

    // Re-sync labels: on explicit toggle + after each View Transition swap
    // (inline script fires 'themechange'), and on every page load as a backstop.
    window.addEventListener('themechange', (e) => {
      sync((e as CustomEvent<{ theme: 'light' | 'dark' }>).detail.theme);
    });
    document.addEventListener('astro:page-load', () => sync(getTheme()));

    sync(getTheme());
  }

  initThemeToggle();

  document.addEventListener('keydown', async (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    const activeElement = document.activeElement as HTMLElement | null;
    if (activeElement?.tagName === 'INPUT') return;
    if (activeElement?.tagName === 'TEXTAREA') return;
    if (activeElement?.isContentEditable) return;

    // Don't trigger when focus is on interactive elements (WCAG 2.1.4)
    if (activeElement?.tagName === 'BUTTON') return;
    if (activeElement?.tagName === 'A') return;
    if (activeElement?.tagName === 'SELECT') return;

    // Don't trigger keyboard shortcuts when menu is open
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu?.classList.contains('open')) return;

    if (e.key === 'c' || e.key === 'C') {
      const { navigate } = await import('astro:transitions/client');
      navigate('/contact');
    }
  });

  const { TextScramble } = await import('../utils/text-scramble');

  let textScramble: InstanceType<typeof TextScramble> | null = null;
  let currentBreadcrumbText = '';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function clearBreadcrumb(separator: HTMLElement, breadcrumb: HTMLAnchorElement) {
    separator.textContent = '';
    separator.classList.remove('visible');
    breadcrumb.textContent = '';
    breadcrumb.removeAttribute('href');
    currentBreadcrumbText = '';
  }

  function updateBreadcrumb() {
    const separator = document.getElementById('breadcrumb-separator');
    const breadcrumb = document.getElementById('breadcrumb') as HTMLAnchorElement | null;
    if (!separator || !breadcrumb) return;

    const pathname = window.location.pathname;

    // No breadcrumb on 404 pages
    const is404Page = document.querySelector('[data-page-type="404"]') !== null;
    if (is404Page) {
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // No breadcrumb on home page - view transitions handle the fade-out
    if (pathname === '/') {
      if (currentBreadcrumbText !== '') {
        clearBreadcrumb(separator, breadcrumb);
      }
      return;
    }

    // Get the first segment of the path
    const segments = pathname.split('/').filter(Boolean);
    if (segments.length === 0) {
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // Only show breadcrumb for known sections
    const knownSections = ['about', 'writing', 'projects'];
    const section = segments[0];

    if (!knownSections.includes(section)) {
      // Unknown section (like 404 pages) - hide breadcrumb
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // Capitalize first letter of the section
    const sectionName = section.charAt(0).toUpperCase() + section.slice(1);

    // Check if DOM was cleared by view transitions
    const domWasCleared = !breadcrumb.textContent;

    // Only animate if section is actually changing
    if (sectionName !== currentBreadcrumbText) {
      separator.textContent = '/';
      breadcrumb.href = `/${section}`;

      if (prefersReducedMotion()) {
        separator.classList.add('visible');
        breadcrumb.textContent = sectionName;
      } else {
        // Always create fresh scramble instance to avoid stale state
        textScramble = new TextScramble(breadcrumb);
        // Force browser to render opacity:0 before transitioning
        void separator.offsetWidth;
        requestAnimationFrame(() => {
          separator.classList.add('visible');
        });
        textScramble.setText(sectionName);
      }
      currentBreadcrumbText = sectionName;
    } else if (domWasCleared) {
      // Restore without animation if view transitions cleared the DOM
      separator.textContent = '/';
      separator.classList.add('visible');
      breadcrumb.href = `/${section}`;
      breadcrumb.textContent = sectionName;
    }
  }

  // Update on initial load
  updateBreadcrumb();

  // Update on view transitions (for Astro's view transitions)
  document.addEventListener('astro:after-swap', updateBreadcrumb);
  document.addEventListener('astro:page-load', updateBreadcrumb);
</script>
