---
import KeyboardShortcut from './KeyboardShortcut.astro';
import { toSitePath } from '../utils/site-config';

const homePath = toSitePath('/', Astro.site);
const aboutPath = toSitePath('/about', Astro.site);
const projectsPath = toSitePath('/projects', Astro.site);
const writingPath = toSitePath('/writing', Astro.site);
const contactPath = toSitePath('/contact', Astro.site);
const rssPath = toSitePath('/rss.xml', Astro.site);
---

<header class="header">
  <div class="nav">
    <nav class="logo-breadcrumb" aria-label="Breadcrumb">
      <a href={homePath} class="logo" aria-label="Roni Helppi, home">Roni Helppi</a>
      <span class="breadcrumb-separator" id="breadcrumb-separator" aria-hidden="true"></span>
      <a href={homePath} class="breadcrumb" id="breadcrumb"></a>
    </nav>

    <nav class="nav-links" aria-label="Main">
      <a href={aboutPath} class="nav-link">About</a>
      <a href={projectsPath} class="nav-link">Projects</a>
      <a href={writingPath} class="nav-link">Writing</a>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
      >
        <svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M22 12L23 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 2V1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 23V22" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 20L19 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 4L19 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 20L5 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 4L5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M1 12L2 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 11.5066C3 16.7497 7.25034 21 12.4934 21C16.2209 21 19.4466 18.8518 21 15.7259C12.4934 15.7259 8.27411 11.5066 8.27411 3C5.14821 4.55344 3 7.77915 3 11.5066Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <a href={contactPath} class="contact-button">
        <span>Contact</span>
        <KeyboardShortcut key="C" label="Press C to go to contact page" />
      </a>

      <button class="menu-button" id="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M13 5H21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 12H21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M3 19H21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6.75827 17.2426L12.0009 12M12.0009 12L17.2435 6.75736M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav class="mobile-menu-nav" aria-label="Mobile navigation">
    <a href={homePath} class="mobile-menu-link">Home</a>
    <a href={aboutPath} class="mobile-menu-link">About</a>
    <a href={projectsPath} class="mobile-menu-link">Projects</a>
    <a href={writingPath} class="mobile-menu-link">Writing</a>
    <a href={contactPath} class="mobile-menu-link">Contact</a>
  </nav>
  <div class="mobile-menu-footer">
    <a href={rssPath} class="mobile-menu-rss">RSS</a>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--header-height);
    width: 100%;
    padding: 0 var(--spacing-horizontal-tablet);
    view-transition-name: header;
  }

  ::view-transition-old(header),
  ::view-transition-new(header),
  ::view-transition-group(header),
  ::view-transition-image-pair(header) {
    animation: none !important;
    opacity: 1 !important;
    mix-blend-mode: normal !important;
  }

  /* During a theme toggle (html.theme-transition) drop the named snapshots for
     the persisted header and breadcrumb so the whole viewport is captured as a
     single `root` snapshot and the circular reveal wipes across it uniformly.
     Page navigation never sets this class, so header persistence and the
     breadcrumb fade-out below stay exactly as before. */
  :global(html.theme-transition) .header,
  :global(html.theme-transition) .breadcrumb-separator,
  :global(html.theme-transition) .breadcrumb {
    view-transition-name: none;
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: calc(var(--layout-width) + var(--gap-section));
    min-height: 1px;
  }

  .logo {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-breadcrumb {
    display: flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
    white-space: nowrap;
  }

  .breadcrumb-separator {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
    view-transition-name: breadcrumb-separator;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-separator {
      transition: none;
    }

    .theme-icon {
      transition: none;
    }

    ::view-transition-old(breadcrumb-text),
    ::view-transition-old(breadcrumb-separator),
    ::view-transition-new(breadcrumb-text),
    ::view-transition-new(breadcrumb-separator) {
      animation: none;
    }

    .mobile-menu-link {
      transition: none;
      opacity: 1;
      transform: none;
    }

    .mobile-menu.open .mobile-menu-link {
      transition-delay: 0ms;
    }
  }

  .breadcrumb-separator.visible {
    opacity: 1;
  }

  .breadcrumb-separator:empty {
    display: none;
  }

  .breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    text-decoration: none;
    view-transition-name: breadcrumb-text;
  }

  /* View transition animations for breadcrumb fade-out */
  ::view-transition-old(breadcrumb-text),
  ::view-transition-old(breadcrumb-separator) {
    animation: fade-out 0.3s ease-out forwards;
  }

  ::view-transition-new(breadcrumb-text),
  ::view-transition-new(breadcrumb-separator) {
    animation: none;
  }

  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .breadcrumb:hover,
  .breadcrumb:focus-visible {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  .breadcrumb:empty {
    display: none;
  }

  .nav-links {
    display: flex;
    gap: var(--gap-lg);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-nav);
    font-weight: 400;
    letter-spacing: var(--tracking-nav);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    grid-column: 3;
    justify-self: end;
  }

  /* Theme toggle (shared by desktop header and mobile menu) */
  .theme-toggle {
    display: inline-grid;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: color 150ms, background-color 150ms, transform 150ms var(--ease-out);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--color-text-primary);
    background-color: var(--color-surface-hover);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .theme-icon {
    grid-area: 1 / 1;
    transition:
      opacity 180ms var(--ease-out),
      filter 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  /* Show the icon for the theme the toggle switches TO. Dark shows the sun
     (switch to light); light shows the moon (switch to dark). */
  .theme-icon-moon {
    opacity: 0;
    filter: blur(1.5px);
    transform: scale(0.96);
  }

  .theme-icon-sun {
    opacity: 1;
    filter: none;
    transform: scale(1);
  }

  :global(:root[data-theme='light']) .theme-icon-sun {
    opacity: 0;
    filter: blur(1.5px);
    transform: scale(0.96);
  }

  :global(:root[data-theme='light']) .theme-icon-moon {
    opacity: 1;
    filter: none;
    transform: scale(1);
  }

  .contact-button {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
    padding: 4px 8px;
    min-height: 24px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-button-text);
    text-decoration: none;
  }

  .contact-button {
    transition: filter 150ms, transform 150ms var(--ease-out);
  }

  .contact-button:hover {
    text-decoration: none;
    filter: brightness(0.85);
  }

  /* opacity:1 suppresses the global touch link dip — this filled button uses
     scale as its sole press feedback. */
  .contact-button:active {
    transform: scale(0.97);
    opacity: 1;
  }

  .menu-button {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    margin: -8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-text-primary);
    transition: transform 150ms var(--ease-out);
  }

  .menu-button:active {
    transform: scale(0.95);
  }

  .menu-button .close-icon {
    display: none;
  }

  .header.menu-open .menu-button .menu-icon {
    display: none;
  }

  .header.menu-open .menu-button .close-icon {
    display: block;
  }

  /* Keep the header stacked above the mobile menu while it's open AND while it
     fades out (.menu-closing). Removing the elevation instantly on close would
     let the dismissing (still-blurred) overlay pass over the top-bar items for
     a frame, flashing them. */
  .header.menu-open,
  .header.menu-closing {
    position: relative;
    z-index: 101;
    background-color: transparent;
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    display: none;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-overlay);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    padding: calc(var(--header-height) + 72px) var(--spacing-horizontal-phone) calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    /* Transitions resolve from the destination state: this rule times the
       CLOSE (dismissal snaps faster than entrance). */
    transition: opacity 0.2s var(--ease-out), visibility 0.2s var(--ease-out);
  }

  .mobile-menu.open {
    display: block;
    opacity: 1;
    visibility: visible;
    overscroll-behavior: contain;
    /* ...and this rule times the OPEN. */
    transition: opacity 0.3s var(--ease-out), visibility 0.3s var(--ease-out);
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .mobile-menu-link {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -1.6px;
    color: var(--color-text-secondary);
    text-decoration: none;
    opacity: 0;
    transform: translateY(-20px);
    /* Destination state when closing — links exit faster than they enter */
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), color 0.2s ease;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link:focus-visible {
    text-decoration: underline;
    color: var(--color-text-primary);
  }

  .mobile-menu-link[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .mobile-menu.open .mobile-menu-link {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out), color 0.2s ease;
  }

  /* Cascading animation delays */
  .mobile-menu.open .mobile-menu-link:nth-child(1) {
    transition-delay: 0ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(2) {
    transition-delay: 50ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(3) {
    transition-delay: 100ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(4) {
    transition-delay: 150ms;
  }

  .mobile-menu.open .mobile-menu-link:nth-child(5) {
    transition-delay: 200ms;
  }

  /* Reset delays when closing */
  .mobile-menu:not(.open) .mobile-menu-link {
    transition-delay: 0ms;
  }

  /* Mobile menu footer with theme toggle and RSS link */
  .mobile-menu-footer {
    position: absolute;
    bottom: 24px;
    left: var(--spacing-horizontal-phone);
    right: var(--spacing-horizontal-phone);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .mobile-menu-rss {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -1.2px;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-align: right;
  }

  .mobile-menu-rss:hover,
  .mobile-menu-rss:focus-visible {
    color: var(--color-text-primary);
  }

  /* Phone */
  @media (max-width: 600px) {
    .header {
      padding: 0 var(--spacing-horizontal-phone);
    }

    .nav-links {
      display: none;
    }

    /* Keep the actions row for the theme toggle, but drop the contact button —
       Contact lives in the mobile menu instead. */
    .contact-button {
      display: none;
    }

    /* Match the theme toggle's tap target to the menu button on touch. Touch
       has no hover state, so show it at full contrast (like the menu button)
       rather than the muted secondary colour used on tablet/desktop. */
    .header-actions .theme-toggle {
      width: 40px;
      height: 40px;
      color: var(--color-text-primary);
    }

    .menu-button {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-menu {
      display: flex;
    }
  }
</style>

<script>
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

  function stripBasePath(path: string) {
    if (!basePath) {
      return path;
    }

    if (path === basePath) {
      return '/';
    }

    return path.startsWith(basePath) ? path.slice(basePath.length) || '/' : path;
  }

  function toBaseAwarePath(path: string) {
    if (path === '/') {
      return basePath ? `${basePath}/` : '/';
    }

    return `${basePath}${path}`;
  }

  // Update active navigation state based on current URL
  function updateActiveNavLinks() {
    const pathname = stripBasePath(window.location.pathname);

    // Get all nav links (desktop and mobile)
    const desktopLinks = document.querySelectorAll('.nav-link');
    const mobileLinks = document.querySelectorAll('.mobile-menu-link');

    // Clear all aria-current attributes first
    desktopLinks.forEach(link => link.removeAttribute('aria-current'));
    mobileLinks.forEach(link => link.removeAttribute('aria-current'));

    // Determine the active section based on pathname
    const getActiveSection = (path: string): string => {
      if (path === '/') return '/';
      const segments = path.split('/').filter(Boolean);
      if (segments.length > 0) {
        return `/${segments[0]}`;
      }
      return '/';
    };

    const activeSection = getActiveSection(pathname);

    // Set aria-current for matching links
    const setAriaCurrentForLinks = (links: NodeListOf<Element>) => {
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (!href) return;
        const normalizedHref = stripBasePath(href);

        // Exact match for home
        if (normalizedHref === '/' && activeSection === '/') {
          link.setAttribute('aria-current', 'page');
        }
        // Section match for other pages
        else if (normalizedHref !== '/' && activeSection === normalizedHref) {
          link.setAttribute('aria-current', 'page');
        }
      });
    };

    setAriaCurrentForLinks(desktopLinks);
    setAriaCurrentForLinks(mobileLinks);
  }

  // Initialize active nav state
  updateActiveNavLinks();

  // Update on view transitions
  document.addEventListener('astro:after-swap', updateActiveNavLinks);
  document.addEventListener('astro:page-load', updateActiveNavLinks);

  // Mobile menu toggle functionality
  let mobileMenuAbortController: AbortController | null = null;

  function initMobileMenu() {
    // Abort previous document/window listeners to prevent accumulation
    mobileMenuAbortController?.abort();
    mobileMenuAbortController = new AbortController();
    const { signal } = mobileMenuAbortController;

    const menuButton = document.getElementById('menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.querySelector('.header');
    const menuLinks = mobileMenu?.querySelectorAll('.mobile-menu-link');

    if (!menuButton || !mobileMenu || !header) return;

    // Store references to avoid TypeScript null warnings in nested functions
    const menu = mobileMenu;
    const btn = menuButton;
    const hdr = header;

    function openMenu() {
      // Cancel any in-flight close so a rapid re-open doesn't strand the class.
      hdr.classList.remove('menu-closing');
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      hdr.classList.add('menu-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      document.body.classList.add('scroll-lock');
      // Trap focus: make main content inert so focus stays in menu
      const mainContent = document.querySelector('main');
      if (mainContent) mainContent.setAttribute('inert', '');
    }

    function closeMenu() {
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      // Swap the icon back to the hamburger immediately, but hold the header's
      // z-index elevation until the overlay finishes fading (menu-closing), so
      // the top-bar items aren't covered by the dismissing overlay mid-fade.
      hdr.classList.remove('menu-open');
      hdr.classList.add('menu-closing');
      menu.addEventListener('transitionend', function onFadeEnd(e) {
        if (e.target !== menu || e.propertyName !== 'opacity') return;
        hdr.classList.remove('menu-closing');
        menu.removeEventListener('transitionend', onFadeEnd);
      });
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      document.body.classList.remove('scroll-lock');
      // Release focus trap
      const mainContent = document.querySelector('main');
      if (mainContent) mainContent.removeAttribute('inert');
    }

    function toggleMenu() {
      const isOpen = menu.classList.contains('open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Toggle on button click
    btn.addEventListener('click', toggleMenu);

    // Close on link click
    menuLinks?.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key (uses signal to prevent listener accumulation)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
        btn.focus();
      }
    }, { signal });

    // Close menu on resize to desktop (uses signal to prevent listener accumulation)
    window.addEventListener('resize', () => {
      if (window.innerWidth > 600 && menu.classList.contains('open')) {
        closeMenu();
      }
    }, { signal });
  }

  // Initialize on page load
  initMobileMenu();

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:after-swap', initMobileMenu);

  // Theme toggle: the palette itself is applied by the inline script in
  // BaseLayout (which owns localStorage + View Transition reapplication).
  // Here we only wire the controls and keep their labels in sync. The Header
  // is transition:persist, so this runs once and the buttons/listeners persist.
  interface ThemeWindow extends Window {
    __getTheme?: () => 'light' | 'dark';
    __setTheme?: (theme: 'light' | 'dark') => void;
  }

  function initThemeToggle() {
    const w = window as ThemeWindow;

    const getTheme = (): 'light' | 'dark' => w.__getTheme?.() ?? 'dark';
    const labelFor = (theme: 'light' | 'dark') =>
      theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme';

    const sync = (theme: 'light' | 'dark') => {
      document
        .querySelectorAll<HTMLButtonElement>('.theme-toggle')
        .forEach((btn) => btn.setAttribute('aria-label', labelFor(theme)));
    };

    // Event delegation on document survives both transition:persist and full
    // DOM swaps, so the control keeps working after any navigation.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const toggle = target?.closest('.theme-toggle') as HTMLElement | null;
      if (!toggle) return;

      // Stamp the click point on <html> so the circular-reveal view-transition
      // CSS (in BaseLayout) can grow the wipe from the button. Radius = distance
      // to the farthest viewport corner, so the circle always fills the screen.
      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const r = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );
      const root = document.documentElement;
      root.style.setProperty('--reveal-x', `${x}px`);
      root.style.setProperty('--reveal-y', `${y}px`);
      root.style.setProperty('--reveal-r', `${r}px`);

      w.__setTheme?.(getTheme() === 'light' ? 'dark' : 'light');
    });

    // Re-sync labels: on explicit toggle + after each View Transition swap
    // (inline script fires 'themechange'), and on every page load as a backstop.
    window.addEventListener('themechange', (e) => {
      sync((e as CustomEvent<{ theme: 'light' | 'dark' }>).detail.theme);
    });
    document.addEventListener('astro:page-load', () => sync(getTheme()));

    sync(getTheme());
  }

  initThemeToggle();

  document.addEventListener('keydown', async (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    const activeElement = document.activeElement as HTMLElement | null;
    if (activeElement?.tagName === 'INPUT') return;
    if (activeElement?.tagName === 'TEXTAREA') return;
    if (activeElement?.isContentEditable) return;

    // Don't trigger when focus is on interactive elements (WCAG 2.1.4)
    if (activeElement?.tagName === 'BUTTON') return;
    if (activeElement?.tagName === 'A') return;
    if (activeElement?.tagName === 'SELECT') return;

    // Don't trigger keyboard shortcuts when menu is open
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu?.classList.contains('open')) return;

    if (e.key === 'c' || e.key === 'C') {
      // Keyboard-initiated navigation should feel instant: suppress the page
      // dissolve for this navigation only (CSS hook lives in BaseLayout).
      const root = document.documentElement;
      root.classList.add('vt-instant');
      document.addEventListener(
        'astro:page-load',
        () => root.classList.remove('vt-instant'),
        { once: true }
      );
      const { navigate } = await import('astro:transitions/client');
      navigate(toBaseAwarePath('/contact'));
    }
  });

  const { TextScramble } = await import('../utils/text-scramble');

  let textScramble: InstanceType<typeof TextScramble> | null = null;
  let currentBreadcrumbText = '';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function clearBreadcrumb(separator: HTMLElement, breadcrumb: HTMLAnchorElement) {
    separator.textContent = '';
    separator.classList.remove('visible');
    breadcrumb.textContent = '';
    breadcrumb.removeAttribute('href');
    currentBreadcrumbText = '';
  }

  function updateBreadcrumb() {
    const separator = document.getElementById('breadcrumb-separator');
    const breadcrumb = document.getElementById('breadcrumb') as HTMLAnchorElement | null;
    if (!separator || !breadcrumb) return;

    const pathname = stripBasePath(window.location.pathname);

    // No breadcrumb on 404 pages
    const is404Page = document.querySelector('[data-page-type="404"]') !== null;
    if (is404Page) {
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // No breadcrumb on home page - view transitions handle the fade-out
    if (pathname === '/') {
      if (currentBreadcrumbText !== '') {
        clearBreadcrumb(separator, breadcrumb);
      }
      return;
    }

    // Get the first segment of the path
    const segments = pathname.split('/').filter(Boolean);
    if (segments.length === 0) {
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // Only show breadcrumb for known sections
    const knownSections = ['about', 'writing', 'projects'];
    const section = segments[0];

    if (!knownSections.includes(section)) {
      // Unknown section (like 404 pages) - hide breadcrumb
      clearBreadcrumb(separator, breadcrumb);
      return;
    }

    // Capitalize first letter of the section
    const sectionName = section.charAt(0).toUpperCase() + section.slice(1);

    // Check if DOM was cleared by view transitions
    const domWasCleared = !breadcrumb.textContent;

    // Only animate if section is actually changing
    if (sectionName !== currentBreadcrumbText) {
      separator.textContent = '/';
      breadcrumb.href = toBaseAwarePath(`/${section}`);

      if (prefersReducedMotion()) {
        separator.classList.add('visible');
        breadcrumb.textContent = sectionName;
      } else {
        // Always create fresh scramble instance to avoid stale state.
        // Spreads tuned so the effect resolves in ~0.9s — the near-1s scramble
        // is a deliberate signature moment, just a touch tighter than default.
        textScramble = new TextScramble(breadcrumb, {
          startSpread: 18,
          minDuration: 18,
          durationSpread: 18,
        });
        // Force browser to render opacity:0 before transitioning
        void separator.offsetWidth;
        requestAnimationFrame(() => {
          separator.classList.add('visible');
        });
        textScramble.setText(sectionName);
      }
      currentBreadcrumbText = sectionName;
    } else if (domWasCleared) {
      // Restore without animation if view transitions cleared the DOM
      separator.textContent = '/';
      separator.classList.add('visible');
      breadcrumb.href = toBaseAwarePath(`/${section}`);
      breadcrumb.textContent = sectionName;
    }
  }

  // Update on initial load
  updateBreadcrumb();

  // Update on view transitions (for Astro's view transitions)
  document.addEventListener('astro:after-swap', updateBreadcrumb);
  document.addEventListener('astro:page-load', updateBreadcrumb);
</script>
