---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  schemas?: Record<string, unknown>[];
  /** Site-root-relative path to a plain-markdown twin of this page, if any. */
  mdPath?: string;
}

const SITE_NAME = 'Roni Helppi';
const DEFAULT_DESCRIPTION = 'Senior designer & engineer at Reaktor, speaking all sides of digital. Portfolio and writings on design, technology, and creative work.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
  schemas = [],
  mdPath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;

// Auto-generate BreadcrumbList from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href }
];
pathSegments.forEach((segment, i) => {
  const url = new URL(pathSegments.slice(0, i + 1).join('/') + '/', Astro.site);
  const name = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: i + 2,
    name,
    item: url.href,
  });
});

const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;

const allSchemas = [...schemas, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />

    <!-- Theme init: runs before first paint to avoid a flash of the wrong theme.
         Dark is the default until the user makes an explicit choice. Keeps the
         theme correct across Astro View Transitions and updates the browser UI
         theme-color. Exposes window.__setTheme / __getTheme for the toggle. -->
    <script is:inline>
      (function () {
        if (window.__themeReady) return;
        window.__themeReady = true;

        var STORAGE_KEY = 'theme';
        var THEME_COLORS = { dark: '#0b0b0b', light: '#f6f4f3' };

        function stored() {
          try {
            var v = localStorage.getItem(STORAGE_KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        }

        // Explicit choice wins; default to dark when none has been made.
        function resolve() {
          return stored() || 'dark';
        }

        function applyTo(doc, theme) {
          doc.documentElement.setAttribute('data-theme', theme);
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', THEME_COLORS[theme]);
        }

        function apply(theme) {
          applyTo(document, theme);
          window.dispatchEvent(
            new CustomEvent('themechange', { detail: { theme: theme } })
          );
        }

        window.__getTheme = function () {
          return document.documentElement.getAttribute('data-theme') || resolve();
        };

        window.__setTheme = function (theme) {
          if (theme !== 'light' && theme !== 'dark') return;
          try {
            localStorage.setItem(STORAGE_KEY, theme);
          } catch (e) {}

          // iOS-style circular reveal wipe. The toggle click handler stamps the
          // click point (--reveal-x/y/r) on <html>; the reveal CSS reads those.
          // Scoped by the temporary `theme-transition` class so it never
          // collides with Astro's page-navigation view transitions.
          var reduceMotion = false;
          try {
            reduceMotion = window.matchMedia(
              '(prefers-reduced-motion: reduce)'
            ).matches;
          } catch (e) {}

          if (
            typeof document.startViewTransition !== 'function' ||
            reduceMotion
          ) {
            // Fallback: instant flip, no animation.
            apply(theme);
            return;
          }

          var root = document.documentElement;
          root.classList.add('theme-transition');
          var vt = document.startViewTransition(function () {
            apply(theme);
          });
          var done = function () {
            root.classList.remove('theme-transition');
          };
          vt.finished.then(done, done);
        };

        // Initial application (before body paints -> no flash).
        apply(resolve());

        // Stamp the incoming document before it swaps in, so there's no flash
        // during a View Transition navigation.
        document.addEventListener('astro:before-swap', function (e) {
          applyTo(e.newDocument, resolve());
        });

        // The <html> element is reused across swaps; reassert and notify the
        // toggle control so its label stays in sync.
        document.addEventListener('astro:after-swap', function () {
          apply(resolve());
        });

        // Smooth scrolling (global.css) is for in-page anchor jumps only.
        // Suspend it around router navigations so Astro's scroll restoration
        // (history back/forward) stays instant.
        document.addEventListener('astro:before-preparation', function () {
          document.documentElement.classList.add('is-navigating');
        });
        document.addEventListener('astro:page-load', function () {
          document.documentElement.classList.remove('is-navigating');
        });

        // In-page anchor clicks (heading rail, TOC card, heading anchors):
        // update the URL with replaceState instead of pushing a history entry,
        // so the Back button always leaves the page rather than stepping back
        // through every heading visited. Capture phase so this wins over the
        // Astro router's own click handler (it skips defaultPrevented events).
        document.addEventListener(
          'click',
          function (e) {
            if (e.defaultPrevented || e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var el = e.target instanceof Element ? e.target : null;
            var link = el && el.closest('a[href^="#"]');
            if (!link) return;
            var id = decodeURIComponent(link.getAttribute('href').slice(1));
            var target = id ? document.getElementById(id) : null;
            if (!target) return;
            e.preventDefault();
            history.replaceState(history.state, '', '#' + id);
            // Follows CSS scroll-behavior: smooth unless reduced motion.
            target.scrollIntoView();
          },
          true
        );
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO -->
    <link rel="alternate" type="application/rss+xml" title="Roni Helppi" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM content" href="/llms.txt" />
    {mdPath && <link rel="alternate" type="text/markdown" title="Markdown source" href={mdPath} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="author" content="Roni Helppi" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content="https://ronihelppi.com/about" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@Nashtanir" />
    <meta name="twitter:creator" content="@Nashtanir" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Local fonts -->
    <link rel="preload" href="/fonts/rethink-sans-400-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spectral-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spectral-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>

    <!-- Structured Data -->
    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="site-wrapper">
      <Header transition:persist />
      <slot />
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-copyright">&copy; {new Date().getFullYear()} Roni Helppi</p>
          <nav class="footer-links" aria-label="Social links">
            <a href="https://github.com/ronijaakkola" target="_blank" rel="noopener noreferrer">github<span class="visually-hidden"> (opens in new tab)</span></a>
            <span class="footer-sep" aria-hidden="true">/</span>
            <a href="https://www.linkedin.com/in/ronihelppi/" target="_blank" rel="noopener noreferrer">linkedin<span class="visually-hidden"> (opens in new tab)</span></a>
            <span class="footer-sep" aria-hidden="true">/</span>
            <a href="/rss.xml">rss</a>
          </nav>
        </div>
      </footer>
    </div>
    <Lightbox />
    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://helppi.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>

<style is:global>
  /* Skip to main content link - styled like contact button */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 100;
    padding: 4px 8px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-button-text);
    text-decoration: none;
    opacity: 0;
    /* No transition: the skip link is keyboard-only and must appear instantly */
  }

  .skip-link:focus {
    top: 12px;
    opacity: 1;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .site-footer {
    display: flex;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-text-secondary);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--layout-width);
    padding: var(--gap-sm) var(--spacing-horizontal-desktop);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-text-primary);
  }

  .footer-sep {
    color: var(--color-divider);
  }

  @media (max-width: 960px) {
    .footer-inner {
      padding-left: var(--spacing-horizontal-tablet);
      padding-right: var(--spacing-horizontal-tablet);
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--gap-2xs);
      padding-left: var(--spacing-horizontal-phone);
      padding-right: var(--spacing-horizontal-phone);
    }
  }

  /* Ensure view transition background matches site background */
  ::view-transition {
    background-color: var(--color-bg);
  }

  /* During a theme toggle (html.theme-transition), fold any element carrying an
     inline view-transition-name — e.g. the project cover images that power the
     shared-element navigation animation — into the single root snapshot, so the
     circular reveal wipes across them uniformly instead of morphing their own
     snapshots (which flickers their rounded corners). !important is required to
     beat the inline style. Page navigation never sets this class, so the cover
     transition between the projects pages is unaffected. */
  html.theme-transition [style*="view-transition-name"] {
    view-transition-name: none !important;
  }

  /* Keyboard-initiated navigation (the C shortcut) skips the page transition
     entirely — keyboard actions should feel instant. The class is stamped by
     the shortcut handler in Header and cleared on the next page load. */
  html.vt-instant::view-transition-group(*),
  html.vt-instant::view-transition-image-pair(*),
  html.vt-instant::view-transition-old(*),
  html.vt-instant::view-transition-new(*) {
    animation: none !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dissolve-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes dissolve-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    /* Both halves use a strong ease-out so the incoming page shows up
       immediately — ease-in on the new snapshot delays the moment the user
       is watching most and made every navigation feel slower than it is. */
    ::view-transition-old(root) {
      animation: dissolve-out 0.25s var(--ease-out);
    }

    ::view-transition-new(root) {
      animation: dissolve-in 0.25s var(--ease-out);
    }

    /* Touch devices: keep the dissolve brief. Without hover there is no
       hover-prefetch to hide network latency, so the tap-to-paint delay is
       already longer than on desktop — a long fade on top makes navigation
       feel sluggish. (Theme reveal below is unaffected.) */
    @media (hover: none) {
      ::view-transition-old(root) {
        animation-duration: 0.15s;
      }

      ::view-transition-new(root) {
        animation-duration: 0.15s;
      }
    }

    /* Theme toggle only (html.theme-transition): iOS-style circular reveal.
       The old snapshot (previous theme) holds still underneath while the new
       snapshot (next theme) is clipped in from a growing circle centred on the
       toggle button. This overrides the cross-fade above so only the wipe
       shows. Page navigation never sets this class, so its dissolve is intact. */
    @keyframes theme-reveal {
      from {
        clip-path: circle(0 at var(--reveal-x, 50%) var(--reveal-y, 50%));
      }
      to {
        clip-path: circle(
          var(--reveal-r, 150vmax) at var(--reveal-x, 50%) var(--reveal-y, 50%)
        );
      }
    }

    html.theme-transition::view-transition-old(root) {
      animation: none;
    }

    html.theme-transition::view-transition-new(root) {
      animation: theme-reveal 0.5s var(--ease-in-out);
    }
  }
</style>
