---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const SITE_NAME = 'Roni Helppi';
const DEFAULT_DESCRIPTION = 'Designer at Reaktor, speaking all sides of digital. Portfolio and writings on design, technology, and creative work.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Google Fonts - loaded asynchronously to avoid render blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" />
    </noscript>

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="site-wrapper">
      <Header transition:persist />
      <slot />
    </div>
    <Lightbox />
  </body>
</html>

<style is:global>
  /* Skip to main content link - styled like contact button */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 100;
    padding: 4px 8px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: -0.6px;
    color: var(--color-button-text);
    text-decoration: none;
    opacity: 0;
    transition: top 0.2s ease, opacity 0.2s ease;
  }

  .skip-link:focus {
    top: 12px;
    opacity: 1;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  /* Ensure view transition background matches site background */
  ::view-transition {
    background-color: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dissolve-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes dissolve-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    ::view-transition-old(root) {
      animation: dissolve-out 0.3s ease-out;
    }

    ::view-transition-new(root) {
      animation: dissolve-in 0.3s ease-in;
    }
  }
</style>
