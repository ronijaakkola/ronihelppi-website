---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const SITE_NAME = 'Roni Helppi';
const DEFAULT_DESCRIPTION = 'Designer at Reaktor, speaking all sides of digital. Portfolio and writings on design, technology, and creative work.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <div class="site-wrapper">
      <Header transition:persist />
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* Ensure view transition background matches site background */
  ::view-transition {
    background-color: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dissolve-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes dissolve-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    ::view-transition-old(root) {
      animation: dissolve-out 0.3s ease-out;
    }

    ::view-transition-new(root) {
      animation: dissolve-in 0.3s ease-in;
    }
  }
</style>
