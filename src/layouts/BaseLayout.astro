---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  schemas?: Record<string, unknown>[];
}

const SITE_NAME = 'Roni Helppi';
const DEFAULT_DESCRIPTION = 'Designer at Reaktor, speaking all sides of digital. Portfolio and writings on design, technology, and creative work.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
  schemas = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;

// Auto-generate BreadcrumbList from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href }
];
pathSegments.forEach((segment, i) => {
  const url = new URL(pathSegments.slice(0, i + 1).join('/') + '/', Astro.site);
  const name = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: i + 2,
    name,
    item: url.href,
  });
});

const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;

const allSchemas = [...schemas, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<!doctype html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO -->
    <link rel="alternate" type="application/rss+xml" title="Roni Helppi" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM content" href="/llms.txt" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="author" content="Roni Helppi" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content="https://www.ronihelppi.com/about" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@Nashtanir" />
    <meta name="twitter:creator" content="@Nashtanir" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts - loaded asynchronously to avoid render blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Rethink+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" />
    </noscript>

    <title>{title}</title>

    <!-- Structured Data -->
    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="site-wrapper">
      <Header transition:persist />
      <slot />
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-copyright">&copy; {new Date().getFullYear()} Roni Helppi</p>
          <nav class="footer-links" aria-label="Social links">
            <a href="https://github.com/ronijaakkola" target="_blank" rel="noopener noreferrer">github<span class="visually-hidden"> (opens in new tab)</span></a>
            <span class="footer-sep" aria-hidden="true">/</span>
            <a href="https://www.linkedin.com/in/ronihelppi/" target="_blank" rel="noopener noreferrer">linkedin<span class="visually-hidden"> (opens in new tab)</span></a>
            <span class="footer-sep" aria-hidden="true">/</span>
            <a href="/rss.xml">rss</a>
          </nav>
        </div>
      </footer>
    </div>
    <Lightbox />
    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://helppi.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    )}
  </body>
</html>

<style is:global>
  /* Skip to main content link - styled like contact button */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 100;
    padding: 4px 8px;
    background-color: var(--color-button-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-button-text);
    text-decoration: none;
    opacity: 0;
    transition: top 0.2s ease, opacity 0.2s ease;
  }

  .skip-link:focus {
    top: 12px;
    opacity: 1;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .site-footer {
    display: flex;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-text-secondary);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--layout-width);
    padding: var(--gap-sm) var(--spacing-horizontal-desktop);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .footer-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-text-primary);
  }

  .footer-sep {
    color: var(--color-divider);
  }

  @media (max-width: 960px) {
    .footer-inner {
      padding-left: var(--spacing-horizontal-tablet);
      padding-right: var(--spacing-horizontal-tablet);
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--gap-2xs);
      padding-left: var(--spacing-horizontal-phone);
      padding-right: var(--spacing-horizontal-phone);
    }
  }

  /* Ensure view transition background matches site background */
  ::view-transition {
    background-color: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dissolve-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes dissolve-out {
      from {
        opacity: 1;
      }
      to {
        opacity: 0;
      }
    }

    ::view-transition-old(root) {
      animation: dissolve-out 0.3s ease-out;
    }

    ::view-transition-new(root) {
      animation: dissolve-in 0.3s ease-in;
    }
  }
</style>
