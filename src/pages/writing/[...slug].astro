---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BackLink from '../../components/BackLink.astro';
import { calculateReadTime, formatReadTime } from '../../utils/readTime';
import { getTitle } from '../../utils/title';
import { generateDescription } from '../../utils/description';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

// Derive title from id (preserves original filename)
const title = getTitle(post.id);

// Format date
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate read time
const readTime = formatReadTime(calculateReadTime(post.body));

// Get related posts from frontmatter (properly typed)
const relatedPostSlugs = post.data.relatedPosts || [];
const relatedPosts: CollectionEntry<'posts'>[] = relatedPostSlugs
  .map((slug: string) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is CollectionEntry<'posts'> => p !== undefined);

// Get hero image from frontmatter
const heroImage = post.data.heroImage;

const description = post.data.description || generateDescription(post.body || '');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: post.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: 'https://www.ronihelppi.com',
    },
    ...(heroImage && { image: new URL(heroImage, Astro.site).href }),
  },
];
---

<BaseLayout
  title={`${title} | Roni Helppi`}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  schemas={schemas}
>
  <main id="main-content" class="main">
    <div class="layout">
      <!-- Post Heading -->
      <div class="prose">
        <header class="post-header">
          <BackLink />
          <div class="post-title-group">
            <h1 class="page-title">{title}</h1>
            <div class="post-meta-row">
              <time class="post-meta" datetime={post.data.date.toISOString()}>{formattedDate} • {readTime}</time>
              <button class="copy-markdown-btn" data-title={title} type="button">Copy post</button>
            </div>
          </div>
        </header>
        {post.data.description && (
          <p class="post-ingress">{post.data.description}</p>
        )}
      </div>

      {heroImage && (
        <div class="hero-image-container">
          <img src={heroImage} alt={`Hero image for ${title}`} class="hero-image" width="920" height="518" fetchpriority="high" />
        </div>
      )}

      <!-- Post Content -->
      <div class="prose">
        <article class="post-content">
          <div class="prose-content">
            <Content />
            <span class="writing-cursor" aria-hidden="true"></span>
          </div>
        </article>

        {relatedPosts.length > 0 && (
          <>
            <Divider />

            <section class="related-posts">
              <SectionHeading title="Related posts" />
              <ul class="related-posts-list">
                {relatedPosts.map((relatedPost) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="related-post-icon">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M11.5202 10.1465C11.7155 10.3418 11.7155 10.6584 11.5202 10.8537L9.18687 13.187C9.04387 13.33 8.8288 13.3727 8.642 13.2953C8.45513 13.2179 8.33333 13.0357 8.33333 12.8334V8.16675C8.33333 7.96455 8.45513 7.78222 8.642 7.70482C8.8288 7.62742 9.04387 7.67022 9.18687 7.81322L11.5202 10.1465Z" fill="currentColor"/>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.66667 10.5001C9.66667 10.7762 9.4428 11.0001 9.16667 11.0001H7.16667C5.41777 11.0001 4 9.58235 4 7.83342V3.16675C4 2.89061 4.22386 2.66675 4.5 2.66675C4.77614 2.66675 5 2.89061 5 3.16675V7.83342C5 9.03002 5.97005 10.0001 7.16667 10.0001H9.16667C9.4428 10.0001 9.66667 10.2239 9.66667 10.5001Z" fill="currentColor"/>
                    </svg>
                    <a href={`/writing/${relatedPost.slug}`}>
                      {getTitle(relatedPost.id)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </>
        )}
      </div>
    </div>
  </main>
  <script type="text/plain" id="post-body-raw" set:text={post.body || ''} />
</BaseLayout>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    flex-wrap: wrap;
  }

  .post-meta {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-secondary);
  }

  .copy-markdown-btn {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    background: transparent;
    border: 1px solid var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: -0.6px;
    color: var(--color-text-secondary);
    cursor: pointer;
    line-height: 1;
    min-height: 24px;
  }

  .copy-markdown-btn:hover,
  .copy-markdown-btn:focus-visible {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    outline: none;
  }

  .copy-markdown-btn:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .post-ingress {
    font-size: clamp(16px, calc(16px + 4 * ((100vw - 600px) / 360)), 20px);
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
    margin-top: 24px;
  }

  .hero-image-container {
    width: 100%;
    margin-top: var(--gap-lg);
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
  }

  .post-content {
    margin-top: 24px;
  }

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    margin-top: var(--gap-section);
  }

  .related-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    list-style: none;
    padding-left: 0;
    line-height: var(--leading-body);
  }

  .related-posts-list li {
    display: flex;
    align-items: center;
    gap: var(--gap-4xs);
    color: var(--color-text-primary);
  }

  .related-post-icon {
    flex-shrink: 0;
  }

  .related-posts-list a {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  /* Add spacing between sections */
  .prose > * + :global(.divider) {
    margin-top: var(--gap-section);
  }

  /* Blinking writing cursor */
  .writing-cursor {
    display: none;
  }

  .writing-cursor.placed {
    display: inline-block;
    width: 2px;
    height: 0.95em;
    background-color: var(--color-text-secondary);
    margin-left: 2px;
    vertical-align: -0.1em;
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-cursor.placed {
      display: none;
    }
  }
</style>

<script>
  function initCopyMarkdown() {
    const btn = document.querySelector<HTMLButtonElement>('.copy-markdown-btn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const title = btn.dataset.title ?? '';
      const body = document.getElementById('post-body-raw')?.textContent ?? '';
      const markdown = `# ${title}\n\n${body}`;

      try {
        await navigator.clipboard.writeText(markdown);
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = 'Copy post';
        }, 2000);
      } catch {
        // Clipboard API not available (e.g. non-HTTPS) — silently ignore
      }
    });
  }

  initCopyMarkdown();
  document.addEventListener('astro:page-load', initCopyMarkdown);

  function initCopyCode() {
    document.querySelectorAll<HTMLButtonElement>('.code-copy-btn').forEach((btn) => {
      // Remove any previous listener by cloning
      const fresh = btn.cloneNode(true) as HTMLButtonElement;
      btn.replaceWith(fresh);

      fresh.addEventListener('click', async () => {
        const pre = fresh.closest('.code-block-wrapper')?.querySelector('pre');
        if (!pre) return;

        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          fresh.textContent = 'Copied!';
          setTimeout(() => {
            fresh.textContent = 'Copy';
          }, 2000);
        } catch {
          // Clipboard API unavailable — silently ignore
        }
      });
    });
  }

  initCopyCode();
  document.addEventListener('astro:page-load', initCopyCode);

  function placeCursor() {
    const cursor = document.querySelector('.writing-cursor');
    if (!cursor) return;

    // Reset: move cursor back to prose-content and remove placed class
    const proseContent = cursor.closest('.prose-content');
    if (!proseContent) return;
    proseContent.appendChild(cursor);
    cursor.classList.remove('placed');

    const children = Array.from(proseContent.children).filter((c) => c !== cursor);
    const lastBlock = children[children.length - 1];

    if (lastBlock) {
      const tag = lastBlock.tagName;
      if (['P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6'].includes(tag)) {
        lastBlock.appendChild(cursor);
      } else if (tag === 'UL' || tag === 'OL') {
        const lastLi = lastBlock.querySelector('li:last-child');
        if (lastLi) lastLi.appendChild(cursor);
      } else if (tag === 'BLOCKQUOTE') {
        const lastP = lastBlock.querySelector('p:last-child');
        if (lastP) lastP.appendChild(cursor);
        else lastBlock.appendChild(cursor);
      }
    }

    cursor.classList.add('placed');
  }

  placeCursor();
  document.addEventListener('astro:page-load', placeCursor);
</script>
