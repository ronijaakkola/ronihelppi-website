---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import HeadingRail from '../../components/HeadingRail.astro';
import { calculateReadTime, formatReadTime } from '../../utils/readTime';
import { getTitleFromEntry } from '../../utils/title';
import { generateDescription } from '../../utils/description';
import { extractH2Headings } from '../../utils/extract-headings';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

// Derive title from the original filename (preserves casing)
const title = getTitleFromEntry(post);

// Format date
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate read time
const readTime = formatReadTime(calculateReadTime(post.body || ''));

// Get related posts from frontmatter (properly typed)
const relatedPostSlugs = post.data.relatedPosts || [];
const relatedPosts: CollectionEntry<'posts'>[] = relatedPostSlugs
  .map((slug: string) => allPosts.find((p) => p.id === slug))
  .filter((p): p is CollectionEntry<'posts'> => p !== undefined);

// Get hero image from frontmatter
const heroImage = post.data.heroImage;
const heroImageUrl = heroImage?.src;

const description = post.data.description || generateDescription(post.body || '');

const postURL = new URL(`/writing/${post.id}/`, Astro.site).href;

const dateModified = post.data.dateModified || post.data.date;

// Left-edge heading navigator: built from the post's h2 headings. Only shown
// when there are at least two sections to move between. When present, the inline
// [toc] card is hidden on wide screens (via `[data-has-heading-rail]` in
// global.css) so the two navigators never duplicate each other.
const headingRailItems = extractH2Headings(post.body || '');
const hasHeadingRail = headingRailItems.length >= 2;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: post.data.date.toISOString(),
    dateModified: dateModified.toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postURL,
    },
    author: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: 'https://ronihelppi.com',
    },
    publisher: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: 'https://ronihelppi.com',
    },
    ...(heroImageUrl && { image: new URL(heroImageUrl, Astro.site).href }),
    ...(post.data.tags && { keywords: post.data.tags }),
  },
];
---

<BaseLayout
  title={`${title} — Roni Helppi`}
  description={description}
  image={heroImageUrl}
  type="article"
  publishedTime={post.data.date.toISOString()}
  schemas={schemas}
>
  <main id="main-content" class="main">
    {hasHeadingRail && <HeadingRail headings={headingRailItems} />}
    <article class="layout" data-has-heading-rail={hasHeadingRail ? '' : undefined}>
      <!-- Post Heading -->
      <header class="post-header">
        <div class="post-title-group">
          <h1 class="page-title">{title}</h1>
          {post.data.description && (
            <p class="post-ingress">{post.data.description}</p>
          )}
        </div>
        <div class="post-meta-row">
          <div class="post-meta">
            <a href="/about" rel="author" class="post-author">Roni Helppi</a>
            <span class="post-meta-details">
              <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
              <span class="post-meta-separator" aria-hidden="true">·</span>
              <span>{readTime}</span>
            </span>
          </div>
          <button class="copy-markdown-btn" data-title={title} type="button">Copy post</button>
        </div>
        {heroImage && (
          <div class="hero-image-container">
            <Image
              src={heroImage}
              alt={post.data.heroImageAlt || title}
              class="hero-image"
              widths={[920, 1380, 1843]}
              sizes="(max-width: 960px) 100vw, 920px"
              format="webp"
              quality={78}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </header>

      <!-- Post Content -->
      <div class="prose">
        <div class="post-content">
          <div class="prose-content">
            <Content />
            <span class="writing-cursor" aria-hidden="true"></span>
          </div>
        </div>

        {relatedPosts.length > 0 && (
          <>
            <Divider />

            <section class="related-posts">
              <SectionHeading title="Related posts" />
              <ul class="related-posts-list">
                {relatedPosts.map((relatedPost) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="related-post-icon">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M11.5202 10.1465C11.7155 10.3418 11.7155 10.6584 11.5202 10.8537L9.18687 13.187C9.04387 13.33 8.8288 13.3727 8.642 13.2953C8.45513 13.2179 8.33333 13.0357 8.33333 12.8334V8.16675C8.33333 7.96455 8.45513 7.78222 8.642 7.70482C8.8288 7.62742 9.04387 7.67022 9.18687 7.81322L11.5202 10.1465Z" fill="currentColor"/>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.66667 10.5001C9.66667 10.7762 9.4428 11.0001 9.16667 11.0001H7.16667C5.41777 11.0001 4 9.58235 4 7.83342V3.16675C4 2.89061 4.22386 2.66675 4.5 2.66675C4.77614 2.66675 5 2.89061 5 3.16675V7.83342C5 9.03002 5.97005 10.0001 7.16667 10.0001H9.16667C9.4428 10.0001 9.66667 10.2239 9.66667 10.5001Z" fill="currentColor"/>
                    </svg>
                    <a href={`/writing/${relatedPost.id}`}>
                      {getTitleFromEntry(relatedPost)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </>
        )}
      </div>
    </article>
  </main>
  <script is:inline type="text/plain" id="post-body-raw" set:text={post.body || ''} />
</BaseLayout>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    width: 100%;
    max-width: var(--content-width);
  }

  .post-title-group {
    display: flex;
    flex-direction: column;
  }

  .post-meta-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-xs);
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: clamp(14px, calc(14px + 2 * ((100vw - 600px) / 360)), 16px);
    letter-spacing: var(--tracking-body-tight);
  }

  .post-meta-details {
    display: flex;
    align-items: center;
    gap: var(--gap-4xs);
    color: var(--color-text-secondary);
  }

  .post-meta-separator {
    user-select: none;
  }

  .post-author {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .post-author:hover,
  .post-author:focus-visible {
    text-decoration: underline;
  }

  .copy-markdown-btn {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    background: transparent;
    border: 1px solid var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    color: var(--color-text-secondary);
    cursor: pointer;
    line-height: 1;
    min-height: 24px;
  }

  .copy-markdown-btn:hover,
  .copy-markdown-btn:focus-visible {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    outline: none;
  }

  .copy-markdown-btn:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  @media (hover: none) {
    .copy-markdown-btn {
      position: relative;
    }

    .copy-markdown-btn::after {
      content: '';
      position: absolute;
      inset: -10px -6px;
    }
  }

  .post-ingress {
    font-size: clamp(16px, calc(16px + 4 * ((100vw - 600px) / 360)), 20px);
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
    margin-top: var(--gap-4xs);
  }

  .hero-image-container {
    width: 100%;
    margin-top: calc(-1 * var(--gap-xs));
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
    display: block;
  }

  .post-content {
    margin-top: var(--gap-lg);
  }

  @media (max-width: 600px) {
    .post-content {
      margin-top: var(--gap-sm);
    }
  }

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    margin-top: var(--gap-section);
  }

  .related-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    list-style: none;
    padding-left: 0;
    line-height: var(--leading-body);
  }

  .related-posts-list li {
    display: flex;
    align-items: center;
    gap: var(--gap-4xs);
    color: var(--color-text-primary);
  }

  .related-post-icon {
    flex-shrink: 0;
  }

  .related-posts-list a {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  /* Add spacing between sections */
  .prose > * + :global(.divider) {
    margin-top: var(--gap-section);
  }

  /* Blinking writing cursor */
  .writing-cursor {
    display: none;
  }

  .writing-cursor.placed {
    display: inline-block;
    width: 2px;
    height: 0.95em;
    background-color: var(--color-text-secondary);
    margin-left: 2px;
    vertical-align: -0.1em;
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-cursor.placed {
      display: none;
    }
  }
</style>

<script>
  function initCopyMarkdown() {
    const btn = document.querySelector<HTMLButtonElement>('.copy-markdown-btn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const title = btn.dataset.title ?? '';
      const body = document.getElementById('post-body-raw')?.textContent ?? '';
      const markdown = `# ${title}\n\n${body}`;

      try {
        await navigator.clipboard.writeText(markdown);
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = 'Copy post';
        }, 2000);
      } catch {
        // Clipboard API not available (e.g. non-HTTPS) — silently ignore
      }
    });
  }

  initCopyMarkdown();
  document.addEventListener('astro:page-load', initCopyMarkdown);

  function initCopyCode() {
    document.querySelectorAll<HTMLButtonElement>('.code-copy-btn').forEach((btn) => {
      // Remove any previous listener by cloning
      const fresh = btn.cloneNode(true) as HTMLButtonElement;
      btn.replaceWith(fresh);

      fresh.addEventListener('click', async () => {
        const pre = fresh.closest('.code-block-wrapper')?.querySelector('pre');
        if (!pre) return;

        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          fresh.textContent = 'Copied!';
          setTimeout(() => {
            fresh.textContent = 'Copy';
          }, 2000);
        } catch {
          // Clipboard API unavailable — silently ignore
        }
      });
    });
  }

  initCopyCode();
  document.addEventListener('astro:page-load', initCopyCode);

  function placeCursor() {
    const cursor = document.querySelector('.writing-cursor');
    if (!cursor) return;

    // Reset: move cursor back to prose-content and remove placed class
    const proseContent = cursor.closest('.prose-content');
    if (!proseContent) return;
    proseContent.appendChild(cursor);
    cursor.classList.remove('placed');

    const children = Array.from(proseContent.children).filter((c) => c !== cursor);
    const lastBlock = children[children.length - 1];

    if (lastBlock) {
      const tag = lastBlock.tagName;
      if (['P', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6'].includes(tag)) {
        lastBlock.appendChild(cursor);
      } else if (tag === 'UL' || tag === 'OL') {
        const lastLi = lastBlock.querySelector('li:last-child');
        if (lastLi) lastLi.appendChild(cursor);
      } else if (tag === 'BLOCKQUOTE') {
        const lastP = lastBlock.querySelector('p:last-child');
        if (lastP) lastP.appendChild(cursor);
        else lastBlock.appendChild(cursor);
      }
    }

    cursor.classList.add('placed');
  }

  placeCursor();
  document.addEventListener('astro:page-load', placeCursor);
</script>
