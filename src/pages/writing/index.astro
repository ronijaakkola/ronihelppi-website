---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getCollection } from 'astro:content';
import { getTitle } from '../../utils/title';
import { sortByDateDesc } from '../../utils/sortByDate';

const posts = sortByDateDesc(await getCollection('posts'));
---

<BaseLayout
  title="Writing on Design & Technology | Roni Helppi"
  description="Thoughts on design, technology, and creative work. Articles about UX design, software development, and the intersection of digital and physical."
>
  <main id="main-content" class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <h1 class="page-title">Writing<span class="visually-hidden"> on Design & Technology</span></h1>
          <div class="posts-list">
            {posts.map((post) => (
              <PostListItem
                title={getTitle(post.id)}
                date={post.data.date}
                href={`/writing/${post.slug}`}
                description={post.data.description}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }
</style>
