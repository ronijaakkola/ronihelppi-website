---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { personSchema } from '../utils/schemas';

const experience = [
  { date: '08/2022–', datetime: '2022-08', company: 'Reaktor', role: 'Senior Product Designer' },
  { date: '12/2017–08/2022', datetime: '2017-12/2022-08', company: 'Gofore', role: 'UX Designer' },
  { date: '02/2017–12/2017', datetime: '2017-02/2017-12', company: 'Leadin', role: 'UX Developer' },
  { date: '01/2016–02/2017', datetime: '2016-01/2017-02', company: 'Atostek', role: 'Software Designer' },
  { date: '01/2015–06/2015', datetime: '2015-01/2015-06', company: 'Tampere University', role: 'Research Assistant' },
];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: personSchema,
};

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Roni Helppi',
  url: 'https://ronihelppi.com/about/',
  about: personSchema,
};

const schemas = [personSchema, profilePageSchema, aboutPageSchema];
---

<BaseLayout
  title="About — Roni Helppi"
  description="Senior Product Designer at Reaktor with experience at Gofore, Leadin, and Atostek. Learn about my background, case studies, and how to get in touch."
  schemas={schemas}
>
  <main id="main-content" class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <!-- About Section -->
          <section class="about-section">
            <h1 class="page-title">About<span class="visually-hidden"> Roni Helppi</span></h1>
            <p class="intro">
              I design things, build things, and occasionally convince people they're the same thing.
              At <a href="https://reaktor.com" target="_blank" rel="noopener noreferrer">Reaktor<span class="visually-hidden"> (opens in new tab)</span></a> I work as a consultant across design and engineering.
              On my own time, I'm deep in AI, generative tools, and pushing the edges of what design and code can do together.
            </p>
            <p class="intro-secondary">
              If you are interested in my work, check the <a href="/projects">projects</a> page. My posts and notes you can find from the <a href="/writing">writing</a> page.
            </p>
          </section>

          <!-- Experience Section -->
          <section class="section">
            <SectionHeading title="Experience" />
            <div class="experience-table-wrapper">
              <table class="experience-table">
                <caption class="visually-hidden">Work experience history</caption>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Company</th>
                    <th>Role</th>
                  </tr>
                </thead>
                <tbody>
                  {experience.map((item) => (
                    <tr>
                      <td class="date-cell" data-label="Date"><time datetime={item.datetime}>{item.date}</time></td>
                      <td class="company-cell" data-label="Company">{item.company}</td>
                      <td class="role-cell" data-label="Role">{item.role}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- How to Reach Me Section -->
          <section class="section">
            <SectionHeading title="How to reach me" />
            <p class="contact-text">
              <!-- Reach me out via <a href="mailto:hello@ronihelppi.com">email</a> or -->
              Reach me out via{' '}
              <a href="https://www.linkedin.com/in/ronihelppi/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in new tab)</span></a>.
              You can also find some of my work on{' '}
              <a href="https://github.com/ronijaakkola" target="_blank" rel="noopener noreferrer">GitHub<span class="visually-hidden"> (opens in new tab)</span></a>.
            </p>
            <p class="contact-text contact-text-secondary">
              For the quick version, the <a href="/contact">contact page</a> has the relevant links in one place.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
  }

  /* About Section */
  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .intro {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
    max-width: 100%;
  }

  .intro-secondary {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    max-width: 100%;
  }

  .intro a {
    text-decoration-line: underline;
  }

  .intro-secondary a {
    color: var(--color-text-secondary);
    text-decoration-line: underline;
  }

  .intro-secondary a:hover,
  .intro-secondary a:focus-visible {
    color: var(--color-text-primary);
  }

  /* Sections */
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  /* Experience Table */
  .experience-table-wrapper {
    padding-bottom: var(--gap-2xs);
  }

  .experience-table {
    width: 100%;
    border-collapse: collapse;
  }

  .experience-table th {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 400;
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
    text-align: left;
    padding-bottom: var(--gap-2xs);
    border-bottom: 1px solid var(--color-divider);
  }

  .experience-table td {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    padding: var(--gap-2xs) 0;
    border-bottom: 1px solid var(--color-divider);
    vertical-align: top;
  }

  .experience-table tr:last-child td {
    border-bottom: none;
  }

  .date-cell {
    color: var(--color-text-secondary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .company-cell {
    color: var(--color-text-primary);
  }

  .role-cell {
    color: var(--color-text-secondary);
  }

  /* Mobile: Stack table rows as cards */
  @media (max-width: 400px) {
    .experience-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .experience-table,
    .experience-table tbody,
    .experience-table tr,
    .experience-table td {
      display: block;
      width: 100%;
    }

    .experience-table tr {
      display: flex;
      flex-direction: column;
      padding: var(--gap-2xs) 0;
      border-bottom: 1px solid var(--color-divider);
    }

    .experience-table tr:last-child {
      border-bottom: none;
    }

    .experience-table td {
      padding: 0;
      border-bottom: none;
    }

    /* Reorder: Date first, Company second, Role third */
    .date-cell {
      order: 1;
      font-size: var(--text-small);
      margin-bottom: 2px;
    }

    .company-cell {
      order: 2;
      font-size: var(--text-body);
    }

    .role-cell {
      order: 3;
      font-size: var(--text-small);
    }
  }

  /* Contact Text */
  .contact-text {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
  }

  .contact-text a {
    text-decoration-line: underline;
  }

  .contact-text-secondary {
    color: var(--color-text-secondary);
  }
</style>
