---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CascadeAnimation from '../../components/CascadeAnimation.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getTitleFromEntry } from '../../utils/title';
import { sortProjects } from '../../utils/sortProjects';
import { balanceTabletGrid } from '../../utils/balanceGrid';

const projects = sortProjects(await getCollection('projects'));

// Tablet balancing for the initial (unfiltered) render. On the 2-column tablet
// grid a narrow card can be stranded alone in a one-slot row; promote those to
// full width up front so the layout is correct before the filter script hydrates
// (it recomputes this on every filter change). Uses the same pure helper the
// client script does, keyed off `span: 2` = wide.
const initialBalance = balanceTabletGrid(projects.map((item) => item.data.span === 2));

// Extract unique categories from tags
function getCategoryFromTag(tag: string): string {
  return tag.replace('#', '');
}

// Build category counts
const categoryCounts = new Map<string, number>();
categoryCounts.set('all', projects.length);

projects.forEach((item) => {
  item.data.tags?.forEach((tag) => {
    const category = getCategoryFromTag(tag);
    categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
  });
});

// Build filters dynamically from content tags
// "All" filter always comes first, then alphabetically sorted categories
const categoryKeys = Array.from(categoryCounts.keys())
  .filter((k) => k !== 'all')
  .sort();

const filters = [
  { id: 'all', label: 'All', count: categoryCounts.get('all') || 0 },
  ...categoryKeys.map((k) => ({
    id: k,
    label: k.charAt(0).toUpperCase() + k.slice(1),
    count: categoryCounts.get(k) || 0,
  })),
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Projects',
    url: 'https://ronihelppi.com/projects/',
    description: 'Selected projects and case studies by Roni Helppi across UX design, games, and creative technology.',
    hasPart: projects.map((item) => ({
      '@type': 'CreativeWork',
      name: getTitleFromEntry(item),
      url: new URL(`/projects/${item.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Projects — Roni Helppi"
  description="Selected projects and case studies in UX design, game development, and creative technology. Explore my portfolio of design work."
  schemas={schemas}
>
  <main id="main-content" class="main">
    <div class="layout projects-layout">
      <div class="content">
        <header class="page-header">
          <h1 class="page-title">Projects<span class="visually-hidden"> — UX Design & Case Studies</span></h1>
          <div class="intro">
            <p>
              A mix of shipped client work, experiments, and games. Some are polished case studies, some are smaller builds that were worth documenting because they taught me something specific.
            </p>
          </div>
        </header>
        <section class="projects-section">
        <!-- Filters -->
        <div class="filters" role="group" aria-label="Filter projects by category">
          {filters.map((filter, index) => (
            <button
              class:list={['filter-chip', { active: index === 0 }]}
              data-filter={filter.id}
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="filter-name">{filter.label}</span>
              <span class="filter-count">[{filter.count}]</span>
            </button>
          ))}
        </div>

        <!-- Filter status for screen readers -->
        <div class="visually-hidden" aria-live="polite" id="filter-status"></div>

        <!-- Bento Grid -->
        <div class="bento-grid">
          {projects.map((item, index) => {
            const title = getTitleFromEntry(item);
            const categories = item.data.tags?.map(getCategoryFromTag) || [];
            const coverImage = item.data.coverImage;
            // LCP / eager / cascade decisions stay keyed off the final sorted
            // position, so the flagship (first) card is always prioritized.
            const isPrimaryLcpCandidate = index === 0;
            const isAboveTheFoldCandidate = index < 2;
            // Image size candidates derive from the card's span, not its
            // position: a wide (span 2) card renders larger at every breakpoint.
            const isWide = item.data.span === 2;
            // A card fills the tablet row when it is authored wide OR promoted by
            // the balancer, so its tablet `sizes` clause must be full width — else
            // the browser picks an undersized source for a full-width render. Phone
            // and desktop are unaffected: balancing only applies in the 601–960px
            // tablet range, so the desktop candidate still keys off `isWide`.
            const isFullWidthTablet = isWide || initialBalance[index];
            const tabletSize = isFullWidthTablet ? 'calc(100vw - 40px)' : 'calc(50vw - 32px)';
            const imageSizes = `(max-width: 600px) calc(100vw - 40px), (max-width: 960px) ${tabletSize}, ${isWide ? '605px' : '289px'}`;

            return (
              <a
                href={`/projects/${item.id}`}
                class:list={['grid-item', { 'grid-item--wide': isWide, 'grid-item--balance': initialBalance[index], 'cascade-item': !isAboveTheFoldCandidate }]}
                data-categories={categories.join(',')}
                style={`--cascade-delay: ${Math.max(index - 1, 0) * 60}ms`}
              >
                {coverImage ? (
                  <Image
                    src={coverImage}
                    alt={title}
                    class="grid-item-image"
                    widths={isWide ? [372, 605, 744, 1168] : [289, 372, 584, 744]}
                    sizes={imageSizes}
                    format="webp"
                    quality={70}
                    loading={isAboveTheFoldCandidate ? 'eager' : 'lazy'}
                    fetchpriority={isPrimaryLcpCandidate ? 'high' : 'auto'}
                    style={`view-transition-name: project-cover-${item.id}`}
                  />
                ) : (
                  <span class="visually-hidden">{title}</span>
                )}
                <div class="grid-item-overlay">
                  <span class="grid-item-title" data-text={title}></span>
                  <span class="grid-item-year" data-text={String(item.data.date.getFullYear())}></span>
                </div>
              </a>
            );
          })}
        </div>
        </section>
      </div>
    </div>
  </main>
  <CascadeAnimation selector=".bento-grid" />
</BaseLayout>

<style>
  .projects-layout {
    max-width: var(--layout-width);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    width: 100%;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    max-width: 44rem;
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .intro a {
    color: var(--color-text-secondary);
    text-decoration-line: underline;
  }

  .intro a:hover,
  .intro a:focus-visible {
    color: var(--color-text-primary);
  }

  .projects-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  /* Filters */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
  }

  .filter-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    min-height: 24px;
    border-radius: var(--radius-sm);
    border: 0.5px solid var(--color-border);
    background: var(--color-bg);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-mono);
    line-height: normal;
    transition: background-color 100ms ease, color 100ms ease, transform 150ms var(--ease-out);
  }

  .filter-chip:active {
    transform: scale(0.97);
  }

  .filter-chip .filter-name {
    color: var(--color-text-primary);
  }

  .filter-chip .filter-count {
    color: var(--color-text-secondary);
    font-weight: 300;
    margin-left: 0.25em;
  }

  .filter-chip.active {
    background: var(--color-button-bg);
  }

  .filter-chip.active .filter-name {
    color: var(--color-button-text);
  }

  .filter-chip.active .filter-count {
    color: var(--color-button-text-muted);
    font-weight: 300;
  }

  .filter-chip:not(.active):hover,
  .filter-chip:not(.active):focus-visible {
    background: var(--color-surface-hover);
  }

  .filter-chip:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* Author-order row placement, never dense: a wide card that cannot fit the
       remaining columns wraps to the next row and leaves the trailing slot
       empty rather than pulling a later card up to backfill it. */
    grid-auto-flow: row;
    gap: var(--gap-md);
    width: calc(100% + 8px);
    padding: 4px;
    margin: -4px;
  }

  .grid-item {
    position: relative;
    height: 224px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 0.5px solid var(--color-border);
    background: var(--color-overlay-light);
    transition: border-color 150ms ease, transform 150ms var(--ease-out);
    text-decoration: none;
  }

  .grid-item:hover,
  .grid-item:focus-visible {
    border-color: var(--color-text-primary);
  }

  /* Touch press feedback: a card has a boundary and an image, so scale reads as
     a physical press (0.99 — gentle, since a full-width card moves its edges
     several px even at a small factor). opacity:1 overrides the global text
     link dip, which would otherwise flash the cover image. */
  @media (hover: none) {
    .grid-item:active {
      opacity: 1;
      transform: scale(0.99);
    }
  }

  .grid-item:hover .grid-item-image,
  .grid-item:focus-visible .grid-item-image {
    transform: scale(1.015);
  }

  .grid-item.hidden {
    display: none;
    opacity: 0;
    transform: scale(0.98);
  }

  /* Filtering: cards fade/scale in and out. `data-filtering` is stamped by the
     filter script on the first user interaction, so the initial render and the
     cascade entrance are unaffected (`animation: none` cancels the long-done
     cascade fill so transitions can drive opacity/transform). Interruptible by
     design — rapid re-filtering retargets mid-fade. Browsers without
     allow-discrete support snap display, exactly as before. */
  .bento-grid[data-filtering] .grid-item {
    animation: none;
    transition:
      opacity 150ms var(--ease-out),
      transform 150ms var(--ease-out),
      display 150ms,
      border-color 150ms ease;
    transition-behavior: allow-discrete;
  }

  @starting-style {
    .bento-grid[data-filtering] .grid-item:not(.hidden) {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .grid-item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 400ms var(--ease-out);
  }

  .grid-item-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 12px 16px;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .grid-item:hover .grid-item-overlay,
  .grid-item:focus-visible .grid-item-overlay {
    opacity: 1;
  }

  .grid-item-title,
  .grid-item-year {
    font-family: var(--font-mono);
    color: var(--color-text-primary);
    background: var(--color-overlay-light);
    backdrop-filter: blur(8px);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    letter-spacing: var(--tracking-mono);
  }

  .grid-item-title {
    font-size: var(--text-code);
  }

  .grid-item-year {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  /* Wide cards span two columns. Driven by each project's `span` frontmatter
     (span: 2) rather than positional nth-child rules, so authoring order and
     content decide the layout. */
  .grid-item--wide {
    grid-column: span 2;
  }

  /* Cascade Animation */
  @keyframes cascade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cascade-animate .cascade-item {
    animation: cascade-in 0.4s var(--ease-out) both;
    animation-delay: var(--cascade-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .cascade-animate .cascade-item {
      animation: none;
    }

    /* Filtering snaps: keep only the hover border feedback */
    .bento-grid[data-filtering] .grid-item {
      transition: border-color 150ms ease;
    }

    .grid-item-image {
      transition: none;
    }

    .grid-item-overlay {
      transition: none;
    }

    /* Drop the touch press scale (movement). Cards forgo press feedback under
       reduced motion; they still navigate, and the reader opted out of motion. */
    .grid-item {
      transition: border-color 150ms ease;
    }

    .grid-item:active {
      transform: none;
    }
  }

  /* Responsive - Tablet */
  @media (max-width: 960px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-md);
    }

    /* Two columns: a wide card fills the whole row. */
    .grid-item--wide {
      grid-column: 1 / -1;
    }
  }

  /* Tablet balancing: a narrow card that would otherwise be stranded alone in a
     one-slot row is promoted to fill the whole row. Scoped to the 601–960px
     tablet range only — it must not touch the desktop 3-column layout (above)
     nor the phone single column (below), where the class is inert. The set of
     promoted cards is authored server-side for the initial render and
     recomputed by the filter script whenever the visible cards change. */
  @media (min-width: 601px) and (max-width: 960px) {
    .grid-item--balance {
      grid-column: 1 / -1;
    }
  }

  /* Touch devices - larger tap targets via invisible hit area, always-visible overlay */
  @media (hover: none) {
    .filter-chip {
      position: relative;
      min-height: 30px;
      padding: 6px 10px;
    }

    .filter-chip::after {
      content: '';
      position: absolute;
      inset: -7px -4px;
    }

    .grid-item-overlay {
      opacity: 1;
    }
  }

  /* Responsive - Phone */
  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
    }

    .grid-item {
      height: 180px;
    }

    /* Single column: wide cards reset to a normal full-width column. */
    .grid-item--wide {
      grid-column: auto;
    }
  }
</style>

<script>
  import { TextScramble } from '../../utils/text-scramble';
  import { balanceTabletGrid } from '../../utils/balanceGrid';

  // Recompute tablet balancing over the currently visible cards, so a narrow
  // card never sits alone in a one-slot row (including after filtering). Reset
  // the class on every card first, then promote the stranded narrow cards among
  // those still visible, in author (DOM) order.
  // Keep a card's tablet image `sizes` in sync with its tablet width. Only the
  // `(max-width: 960px)` clause changes — the phone and desktop candidates stay
  // as authored — so a full-width (wide or balance-promoted) card advertises the
  // full-width source and never loads an undersized one.
  function setTabletSizes(item: HTMLElement, fullWidth: boolean) {
    const img = item.querySelector<HTMLImageElement>('.grid-item-image');
    const sizes = img?.getAttribute('sizes');
    if (!img || !sizes) return;
    const tablet = fullWidth ? 'calc(100vw - 40px)' : 'calc(50vw - 32px)';
    img.setAttribute('sizes', sizes.replace(/\(max-width: 960px\) calc\([^)]*\)/, `(max-width: 960px) ${tablet}`));
  }

  function rebalanceGrid(gridItems: NodeListOf<HTMLElement>) {
    gridItems.forEach((item) => item.classList.remove('grid-item--balance'));

    const visible = Array.from(gridItems).filter((item) => !item.classList.contains('hidden'));
    const promote = balanceTabletGrid(visible.map((item) => item.classList.contains('grid-item--wide')));
    visible.forEach((item, i) => {
      if (promote[i]) item.classList.add('grid-item--balance');
      // Wide and promoted-narrow cards fill the tablet row; un-promoted narrow
      // cards revert to the half-width clause.
      setTabletSizes(item, item.classList.contains('grid-item--wide') || promote[i]);
    });
  }

  // Filter functionality
  function applyFilter(filter: string, filterChips: NodeListOf<HTMLElement>, gridItems: NodeListOf<HTMLElement>) {
    filterChips.forEach((c) => {
      c.classList.remove('active');
      c.setAttribute('aria-pressed', 'false');
    });

    const activeChip = Array.from(filterChips).find((c) => c.dataset.filter === filter);
    if (activeChip) {
      activeChip.classList.add('active');
      activeChip.setAttribute('aria-pressed', 'true');
    }

    gridItems.forEach((item) => {
      const categories = item.dataset.categories ? item.dataset.categories.split(',') : [];
      if (filter === 'all' || categories.includes(filter)) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });

    rebalanceGrid(gridItems);
  }

  function initFilters() {
    const filterChips = document.querySelectorAll<HTMLElement>('.filter-chip');
    const gridItems = document.querySelectorAll<HTMLElement>('.grid-item');
    const filterStatus = document.getElementById('filter-status');

    const params = new URLSearchParams(window.location.search);
    const initialFilter = params.get('filter') || 'all';
    applyFilter(initialFilter, filterChips, gridItems);

    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;
        // Enable filter transitions only after a real interaction, so the
        // initial render (and its cascade entrance) stays untouched.
        document.querySelector('.bento-grid')?.setAttribute('data-filtering', '');
        applyFilter(filter, filterChips, gridItems);

        if (filterStatus) {
          const visibleCount = document.querySelectorAll('.grid-item:not(.hidden)').length;
          const label = chip.querySelector('.filter-name')?.textContent || filter;
          filterStatus.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'project' : 'projects'}${filter !== 'all' ? ` in ${label}` : ''}`;
        }

        const url = new URL(window.location.href);
        if (filter === 'all') {
          url.searchParams.delete('filter');
        } else {
          url.searchParams.set('filter', filter);
        }
        history.replaceState({}, '', url);
      });
    });
  }

  // Text scramble overlay
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isTouchDevice = !window.matchMedia('(hover: hover)').matches;

  function initOverlayScramble() {
    const gridItems = document.querySelectorAll<HTMLElement>('.grid-item');

    gridItems.forEach((item) => {
      const titleEl = item.querySelector<HTMLElement>('.grid-item-title');
      const yearEl = item.querySelector<HTMLElement>('.grid-item-year');
      if (!titleEl || !yearEl) return;

      const titleText = titleEl.getAttribute('data-text') || '';
      const yearText = yearEl.getAttribute('data-text') || '';

      if (isTouchDevice) {
        titleEl.textContent = titleText;
        yearEl.textContent = yearText;
        return;
      }

      const titleScramble = new TextScramble(titleEl);
      const yearScramble = new TextScramble(yearEl);

      item.addEventListener('mouseenter', onEnter);
      item.addEventListener('focusin', onEnter);
      item.addEventListener('mouseleave', onLeave);
      item.addEventListener('focusout', onLeave);

      function onEnter() {
        if (prefersReducedMotion.matches) {
          titleEl!.textContent = titleText;
          yearEl!.textContent = yearText;
        } else {
          titleScramble.setText(titleText);
          yearScramble.setText(yearText);
        }
      }

      function onLeave() {
        titleScramble.cancel();
        yearScramble.cancel();
        titleEl!.textContent = '';
        yearEl!.textContent = '';
      }
    });
  }

  initFilters();
  initOverlayScramble();
  document.addEventListener('astro:page-load', initFilters);
  document.addEventListener('astro:page-load', initOverlayScramble);
</script>
