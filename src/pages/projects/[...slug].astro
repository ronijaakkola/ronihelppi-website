---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import { getTitleFromEntry } from '../../utils/title';
import { generateDescription } from '../../utils/description';
import { toSiteUrl } from '../../utils/site-config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

// Derive title from the original filename (preserves casing)
const title = getTitleFromEntry(item);

const description = item.data.description || generateDescription(item.body || '');
const playLinks = item.data.links?.filter((l) => l.label === 'Play') ?? [];
const otherLinks = item.data.links?.filter((l) => l.label !== 'Play') ?? [];

const projectURL = toSiteUrl(`/projects/${item.id}/`, Astro.site);
const homeUrl = toSiteUrl('/', Astro.site);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description,
    datePublished: item.data.date.toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': projectURL,
    },
    author: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: homeUrl,
    },
    ...(item.data.coverImage && { image: toSiteUrl(item.data.coverImage.src, Astro.site) }),
    ...(item.data.tags && { keywords: item.data.tags }),
  },
];
---

<BaseLayout
  title={`${title} — Roni Helppi`}
  description={description}
  image={item.data.coverImage?.src}
  type="article"
  publishedTime={item.data.date.toISOString()}
  schemas={schemas}
>
  <main id="main-content" class="main">
    <article class="layout">
      <header class="project-header">
        <div class="project-title-group">
          <h1 class="page-title">{title}</h1>
          <p class="project-subtitle">{item.data.subtitle || 'Case study'}</p>
        </div>
        {item.data.coverImage && (
          <div class="cover-image-container">
            <Image
              src={item.data.coverImage}
              alt={item.data.coverImageAlt || `Cover image for ${title}`}
              class="cover-image"
              widths={[600, 920, 1200]}
              sizes="(max-width: 960px) 100vw, 920px"
              format="webp"
              quality={85}
              style={`view-transition-name: project-cover-${item.id}`}
            />
          </div>
        )}
      </header>

      <div class="prose">
        {item.data.description && (
          <p class="project-description">{item.data.description}</p>
        )}

        {item.data.meta && item.data.meta.length > 0 && (
          <div class="project-meta-card">
            <dl class="meta-grid">
              {item.data.meta.map((entry) => (
                <div class="meta-row">
                  <dt class="meta-label">{entry.label}</dt>
                  <dd class="meta-value">
                    {entry.list ? (
                      <ul class="meta-list">
                        {entry.value.split(',').map((item) => (
                          <li class="meta-list-item">{item.trim()}</li>
                        ))}
                      </ul>
                    ) : entry.value}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {(playLinks.length > 0 || otherLinks.length > 0) && (
          <div class="meta-links">
            {playLinks.map((link) => (
              <a href={link.url} class="meta-link meta-link-primary" target="_blank" rel="noopener noreferrer">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M4.5 2.5L13 8L4.5 13.5V2.5Z"/>
                </svg>
                {link.label}
              </a>
            ))}
            {otherLinks.map((link) => (
              <a href={link.url} class="meta-link" target="_blank" rel="noopener noreferrer">
                {link.label}
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5V8.5M9.5 2.5H3.5" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        )}

        <time datetime={item.data.date.toISOString()} class="visually-hidden">
          {item.data.date.toLocaleDateString()}
        </time>

        <Divider />

        <div class="prose-content">
          <Content />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    width: 100%;
    max-width: var(--content-width);
  }

  .project-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
    text-align: center;
  }

  .project-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-secondary);
  }

  .cover-image-container {
    width: 100%;
    margin-top: calc(-1 * var(--gap-xs));
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
  }

  .project-description {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
    margin-top: var(--gap-lg);
  }

  .project-meta-card {
    margin-top: var(--gap-md);
    padding: var(--gap-2xs) 0;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: var(--gap-md);
    padding: var(--gap-2xs) var(--gap-xs);
    border-bottom: 0.5px solid var(--color-divider);
  }

  .meta-row:last-child {
    border-bottom: none;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
    flex-shrink: 0;
    min-width: 72px;
  }

  .meta-value {
    font-family: var(--font-sans);
    font-size: var(--text-code);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
  }

  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3xs);
  }

  .meta-list-item {
    font-family: var(--font-sans);
    font-size: var(--text-code);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
  }

  .meta-list-item + .meta-list-item::before {
    content: '/';
    color: var(--color-divider);
    margin-right: var(--gap-3xs);
  }

  .meta-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-2xs);
    margin-top: var(--gap-sm);
  }

  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 10px;
    min-height: 26px;
    border: 1px solid var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.65px;
    line-height: 1;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: border-color 100ms ease, color 100ms ease;
    width: fit-content;
  }

  .meta-link:hover,
  .meta-link:focus-visible {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    text-decoration: none;
  }

  .meta-link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .meta-link-primary {
    background-color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    color: var(--color-bg);
    padding-left: 8px;
  }

  .meta-link-primary:hover,
  .meta-link-primary:focus-visible {
    filter: brightness(0.85);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
  }

  .meta-link svg {
    flex-shrink: 0;
  }

  .prose > :global(.divider) {
    margin-top: var(--gap-section);
    margin-bottom: var(--gap-section);
  }

</style>
