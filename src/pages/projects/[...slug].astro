---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import { getTitle } from '../../utils/title';
import { generateDescription } from '../../utils/description';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

// Derive title from id (preserves original filename)
const title = getTitle(item.id);

const description = item.data.description || generateDescription(item.body || '');

const projectURL = new URL(`/projects/${item.slug}/`, Astro.site).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description,
    datePublished: item.data.date.toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': projectURL,
    },
    author: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: 'https://www.ronihelppi.com',
    },
    ...(item.data.coverImage && { image: new URL(item.data.coverImage.src, Astro.site).href }),
    ...(item.data.skills && { keywords: item.data.skills }),
  },
];
---

<BaseLayout
  title={`${title} | Roni Helppi`}
  description={description}
  image={item.data.coverImage?.src}
  type="article"
  publishedTime={item.data.date.toISOString()}
  schemas={schemas}
>
  <main id="main-content" class="main">
    <article class="layout">
      <div class="prose">
        <header class="project-header">
          <div class="project-title-group">
            <h1 class="page-title">{title}</h1>
            <p class="project-subtitle">Case study</p>
          </div>
        </header>
      </div>

      {item.data.coverImage && (
        <div class="cover-image-container">
          <Image
            src={item.data.coverImage}
            alt={`Cover image for ${title}`}
            class="cover-image"
            widths={[600, 920, 1200]}
            sizes="(max-width: 960px) 100vw, 920px"
            format="webp"
            quality={85}
            style={`view-transition-name: project-cover-${item.slug}`}
          />
        </div>
      )}

      <div class="prose">
        {item.data.description && (
          <p class="project-description">{item.data.description}</p>
        )}

        <div class="project-meta-card">
          <dl class="meta-grid">
            {item.data.team && (
              <div class="meta-row">
                <dt class="meta-label">Team</dt>
                <dd class="meta-value">{item.data.team}</dd>
              </div>
            )}

            {item.data.duration && (
              <div class="meta-row">
                <dt class="meta-label">Duration</dt>
                <dd class="meta-value">{item.data.duration}</dd>
              </div>
            )}

            {item.data.skills && (
              <div class="meta-row">
                <dt class="meta-label">Skills</dt>
                <dd class="meta-value">{item.data.skills}</dd>
              </div>
            )}

            {item.data.tags && item.data.tags.length > 0 && (
              <div class="meta-row">
                <dt class="meta-label">Tags</dt>
                <dd class="meta-value">
                  <ul class="tags-list">
                    {item.data.tags.map((tag) => (
                      <li class="tag">{tag.replace('#', '')}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>

        </div>

        {item.data.links && item.data.links.length > 0 && (
          <div class="meta-links">
            {item.data.links.map((link) => (
              <a href={link.url} class="meta-link" target="_blank" rel="noopener noreferrer">
                {link.label}
                <svg width="12" height="12" viewBox="0 0 15 18" fill="none" aria-hidden="true">
                  <path d="M3 14.6667L11.6666 6M11.6666 6V14.32M11.6666 6H3.34667" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        )}

        <time datetime={item.data.date.toISOString()} class="visually-hidden">
          {item.data.date.toLocaleDateString()}
        </time>

        <Divider />

        <div class="prose-content">
          <Content />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
  }

  .project-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .project-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-secondary);
  }

  .cover-image-container {
    width: 100%;
    max-width: var(--layout-width);
    margin-top: var(--gap-lg);
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
  }

  .project-description {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
    margin-top: var(--gap-lg);
  }

  .project-meta-card {
    margin-top: var(--gap-md);
    padding: var(--gap-2xs) 0;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: var(--gap-md);
    padding: var(--gap-2xs) var(--gap-xs);
    border-bottom: 0.5px solid var(--color-divider);
  }

  .meta-row:last-child {
    border-bottom: none;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: -0.7px;
    color: var(--color-text-secondary);
    flex-shrink: 0;
    min-width: 72px;
  }

  .meta-value {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.7px;
    color: var(--color-text-primary);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: -0.7px;
    color: var(--color-text-primary);
  }

  .meta-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-2xs);
    margin-top: var(--gap-sm);
  }

  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 10px;
    min-height: 26px;
    border: 1px solid var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.65px;
    line-height: 1;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: border-color 100ms ease, color 100ms ease;
    width: fit-content;
  }

  .meta-link:hover,
  .meta-link:focus-visible {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
    text-decoration: none;
  }

  .meta-link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .meta-link svg {
    flex-shrink: 0;
  }

  .prose > :global(.divider) {
    margin-top: var(--gap-section);
    margin-bottom: var(--gap-section);
  }

</style>
