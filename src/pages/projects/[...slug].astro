---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import { getTitle } from '../../utils/title';
import { generateDescription } from '../../utils/description';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

// Derive title from id (preserves original filename)
const title = getTitle(item.id);

const description = item.data.description || generateDescription(item.body || '');

const projectURL = new URL(`/projects/${item.slug}/`, Astro.site).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description,
    datePublished: item.data.date.toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': projectURL,
    },
    author: {
      '@type': 'Person',
      name: 'Roni Helppi',
      url: 'https://www.ronihelppi.com',
    },
    ...(item.data.coverImage && { image: new URL(item.data.coverImage.src, Astro.site).href }),
    ...(item.data.skills && { keywords: item.data.skills }),
  },
];
---

<BaseLayout
  title={`${title} | Roni Helppi`}
  description={description}
  image={item.data.coverImage?.src}
  type="article"
  publishedTime={item.data.date.toISOString()}
  schemas={schemas}
>
  <main id="main-content" class="main">
    <article class="layout">
      <div class="prose">
        <header class="project-header">
          <div class="project-title-group">
            <h1 class="page-title">{title}</h1>
            <p class="project-subtitle">Case study</p>
          </div>
        </header>
      </div>

      {item.data.coverImage && (
        <div class="cover-image-container">
          <Image
            src={item.data.coverImage}
            alt={`Cover image for ${title}`}
            class="cover-image"
            widths={[600, 920, 1200]}
            sizes="(max-width: 960px) 100vw, 920px"
            format="webp"
            quality={85}
            style={`view-transition-name: project-cover-${item.slug}`}
          />
        </div>
      )}

      <div class="prose">
        <div class="project-meta">
          {item.data.description && (
            <p class="project-description">{item.data.description}</p>
          )}

          {item.data.team && (
            <div class="meta-item">
              <span class="meta-label">Team</span>
              <span class="meta-value">{item.data.team}</span>
            </div>
          )}

          {item.data.duration && (
            <div class="meta-item">
              <span class="meta-label">Duration</span>
              <span class="meta-value">{item.data.duration}</span>
            </div>
          )}

          {item.data.skills && (
            <div class="meta-item">
              <span class="meta-label">Skills</span>
              <span class="meta-value">{item.data.skills}</span>
            </div>
          )}

          {item.data.tags && item.data.tags.length > 0 && (
            <div class="meta-item">
              <span class="meta-label">Tags</span>
              <ul class="tags-list">
                {item.data.tags.map((tag) => (
                  <li class="tag">{tag.replace('#', '')}</li>
                ))}
              </ul>
            </div>
          )}

          <time datetime={item.data.date.toISOString()} class="visually-hidden">
            {item.data.date.toLocaleDateString()}
          </time>
        </div>

        <Divider />

        <div class="prose-content">
          <Content />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .project-header {
    display: flex;
    flex-direction: column;
  }

  .project-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .project-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-secondary);
  }

  .cover-image-container {
    width: 100%;
    max-width: var(--layout-width);
    margin-top: var(--gap-lg);
  }

  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-border);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin-top: var(--gap-lg);
  }

  .project-description {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
  }

  .meta-value {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
  }

  .prose > :global(.divider) {
    margin-top: var(--gap-section);
    margin-bottom: var(--gap-section);
  }

</style>
