---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostListItem from '../components/PostListItem.astro';
import { getCollection } from 'astro:content';
import { getTitle } from '../utils/title';
import { sortByDateDesc } from '../utils/sortByDate';

const posts = sortByDateDesc(await getCollection('posts'));
const work = sortByDateDesc(await getCollection('work'));
---

<BaseLayout
  title="Roni Helppi | Designer"
  description="Designer at Reaktor, speaking all sides of digital. Portfolio and writings on design, technology, and creative work."
>
  <main id="main-content" class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <!-- Hero Section -->
          <section class="hero-section cascade-item">
            <h1 class="hero-title">
              Speaking all sides of digital<span class="hero-period">.</span>
            </h1>
            <div class="bio">
              <p class="bio-secondary">
                I'm a designer at <a href="https://reaktor.com">Reaktor</a> helping their industrial customers to grow.
                Previously I have worked at various design consultancies like Gofore and Leadin.
              </p>
              <p class="bio-primary">I'm a designer.</p>
            </div>
          </section>

          <Divider class="cascade-item" />

          <!-- Projects Section -->
          <section class="section cascade-item">
            <SectionHeading title="Projects" />
            <div class="projects-list">
              {work.map((item) => (
                <ProjectCard
                  title={getTitle(item.id)}
                  description={item.data.description || ''}
                  href={`/work/${item.slug}`}
                />
              ))}
            </div>
            <a href="/work" class="view-all-link">
              <span>View all projects</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="arrow-icon">
                <path d="M1.5 6H10.5M10.5 6L6.25 1.75M10.5 6L6.25 10.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </section>

          <!-- Writing Section -->
          <section class="section cascade-item">
            <SectionHeading title="Writing" />
            <div class="posts-list">
              {posts.slice(0, 5).map((post) => (
                <PostListItem
                  title={getTitle(post.id)}
                  date={post.data.date}
                  href={`/posts/${post.slug}`}
                />
              ))}
            </div>
            <a href="/posts" class="view-all-link">
              <span>View all posts</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="arrow-icon">
                <path d="M1.5 6H10.5M10.5 6L6.25 1.75M10.5 6L6.25 10.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </section>

          <!-- Elsewhere Section -->
          <section class="section cascade-item">
            <SectionHeading title="Elsewhere" />
            <div class="elsewhere-links">
              <p>
                Reach me out via <a href="mailto:hello@ronihelppi.com">email</a>,{' '}
                <a href="https://twitter.com/ronihelppi">Twitter</a>, or{' '}
                <a href="https://linkedin.com/in/ronihelppi">LinkedIn</a>.
              </p>
              <p>Subscribe to my posts via <a href="/rss.xml">RSS</a>.</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
    overflow: hidden;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    overflow: hidden;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-hero);
    color: var(--color-text-primary);
    line-height: var(--leading-normal);
    max-width: 259px;
    text-wrap: balance;
  }

  .hero-period {
    color: var(--color-text-secondary);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .bio-secondary {
    color: var(--color-text-secondary);
    max-width: 428px;
    line-height: var(--leading-body);
  }

  .bio-secondary a {
    color: var(--color-text-secondary);
    text-decoration-line: underline;
  }

  .bio-secondary a:hover {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-text-primary);
  }

  .bio-primary {
    color: var(--color-text-primary);
    max-width: 428px;
  }

  /* Sections */
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    overflow: hidden;
  }

  /* Projects */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  /* Posts */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  /* View All Links */
  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-4xs);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .view-all-link span {
    text-decoration-line: underline;
    text-decoration-color: var(--color-text-secondary);
    text-underline-offset: 2px;
    transition: text-decoration-color 100ms;
  }

  .view-all-link:hover span {
    text-decoration-color: var(--color-text-primary);
  }

  .arrow-icon {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  /* Elsewhere */
  .elsewhere-links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
    line-height: var(--leading-body);
  }

  .elsewhere-links a {
    text-decoration-line: underline;
  }

  /* Cascade Animation - global to work with child components */
  @keyframes cascade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .cascade-animate :global(.cascade-item) {
    opacity: 0;
    animation: cascade-in 0.4s ease-out forwards;
  }

  .cascade-animate :global(.cascade-item:nth-child(1)) { animation-delay: 0ms; }
  .cascade-animate :global(.cascade-item:nth-child(2)) { animation-delay: 60ms; }
  .cascade-animate :global(.cascade-item:nth-child(3)) { animation-delay: 120ms; }
  .cascade-animate :global(.cascade-item:nth-child(4)) { animation-delay: 180ms; }
  .cascade-animate :global(.cascade-item:nth-child(5)) { animation-delay: 240ms; }

  @media (prefers-reduced-motion: reduce) {
    .cascade-animate :global(.cascade-item) {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script is:inline>
  // Only run cascade animation on direct page load, not SPA navigation
  // The flag is set by astro:after-swap BEFORE this script runs on navigation

  if (!window.__cascadeListenersAdded) {
    window.__cascadeListenersAdded = true;

    // Mark that we're doing SPA navigation (fires before new page script runs)
    document.addEventListener('astro:after-swap', () => {
      window.__wasNavigation = true;
    });
  }

  // Check immediately - on SPA nav, __wasNavigation is already true from after-swap
  // On direct load, it's undefined/false
  if (!window.__wasNavigation) {
    document.querySelector('.content')?.classList.add('cascade-animate');
  }
  window.__wasNavigation = false;
</script>
