---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostListItem from '../components/PostListItem.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const work = await getCollection('work');

// Sort by date descending
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
work.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Helper to derive title from id (preserves original filename casing)
function getTitle(id: string): string {
  return id.replace(/\.md$/, '');
}
---

<BaseLayout title="Roni Helppi">
  <main class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <!-- Hero Section -->
          <section class="hero-section">
            <h1 class="hero-title">
              Speaking all sides of digital<span class="hero-period">.</span>
            </h1>
            <div class="bio">
              <p class="bio-secondary">
                I'm a designer at <a href="https://reaktor.com">Reaktor</a> helping their industrial customers to grow.
                Previously I have worked at various design consultancies like Gofore and Leadin.
              </p>
              <p class="bio-primary">I'm a designer.</p>
            </div>
          </section>

          <Divider />

          <!-- Projects Section -->
          <section class="section">
            <SectionHeading title="Projects" />
            <div class="projects-list">
              {work.map((item) => (
                <ProjectCard
                  title={getTitle(item.id)}
                  description={item.data.description || ''}
                  href={`/work/${item.slug}`}
                />
              ))}
            </div>
            <span class="view-all-link">
              <a href="/work">View all projects</a><span class="arrow">→</span>
            </span>
          </section>

          <!-- Writing Section -->
          <section class="section">
            <SectionHeading title="Writing" />
            <div class="posts-list">
              {posts.slice(0, 5).map((post) => (
                <PostListItem
                  title={getTitle(post.id)}
                  date={post.data.date}
                  href={`/posts/${post.slug}`}
                />
              ))}
            </div>
            <span class="view-all-link">
              <a href="/posts">View all posts</a><span class="arrow">→</span>
            </span>
          </section>

          <!-- Elsewhere Section -->
          <section class="section">
            <SectionHeading title="Elsewhere" />
            <div class="elsewhere-links">
              <p>
                Reach me out via <a href="mailto:hello@ronihelppi.com">email</a>,{' '}
                <a href="https://twitter.com/ronihelppi">Twitter</a>, or{' '}
                <a href="https://linkedin.com/in/ronihelppi">LinkedIn</a>.
              </p>
              <p>Subscribe to my posts via <a href="/rss.xml">RSS</a>.</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
    overflow: hidden;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    overflow: hidden;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-hero);
    color: var(--color-text-primary);
    line-height: normal;
    max-width: 259px;
  }

  .hero-period {
    color: var(--color-text-secondary);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .bio-secondary {
    color: var(--color-text-secondary);
    max-width: 428px;
    line-height: var(--leading-body);
  }

  .bio-secondary a {
    color: var(--color-text-secondary);
    text-decoration: underline;
  }

  .bio-primary {
    color: var(--color-text-primary);
    max-width: 428px;
  }

  /* Sections */
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    overflow: hidden;
  }

  /* Projects */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  /* Posts */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  /* View All Links */
  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
  }

  .view-all-link a {
    text-decoration: underline;
    color: inherit;
  }

  .arrow {
    text-decoration: none;
    color: #AAA1A1;
  }

  /* Elsewhere */
  .elsewhere-links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
    line-height: var(--leading-body);
  }

  .elsewhere-links a {
    text-decoration: underline;
  }
</style>
