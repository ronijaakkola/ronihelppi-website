---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostListItem from '../components/PostListItem.astro';
import CascadeAnimation from '../components/CascadeAnimation.astro';
import { getCollection } from 'astro:content';
import { getTitle } from '../utils/title';
import { sortByDateDesc } from '../utils/sortByDate';
import { personSchema } from '../utils/schemas';

const posts = sortByDateDesc(await getCollection('posts'));
const projects = sortByDateDesc(await getCollection('projects'));

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Roni Helppi',
    url: 'https://www.ronihelppi.com',
  },
  personSchema,
];
---

<BaseLayout
  title="Roni Helppi | Designer"
  description="Designer & engineer at Reaktor. I think by building and write to think — and spend my off-hours deep in AI and whatever's pulling my attention next."
  schemas={schemas}
>
  <main id="main-content" class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <!-- Hero Section -->
          <section class="hero-section cascade-item">
            <h1 class="hero-title">
              Speaking all sides of digital<span class="hero-period">.</span>
            </h1>
            <div class="bio">
              <p class="bio-secondary">
                <span class="bio-highlight">Designer & engineer</span> at <a href="https://reaktor.com" target="_blank" rel="noopener noreferrer">Reaktor</a>. I think by building and write to think — and spend my off-hours deep in AI and whatever's pulling my attention next.
              </p>
            </div>
          </section>

          <Divider class="cascade-item" />

          <!-- Projects Section -->
          <section class="section cascade-item">
            <SectionHeading title="Recent projects" />
            <div class="projects-list">
              {projects.slice(0, 3).map((item) => (
                <ProjectCard
                  title={getTitle(item.id)}
                  description={item.data.description || ''}
                  href={`/projects/${item.slug}`}
                />
              ))}
            </div>
            <a href="/projects" class="view-all-link">
              <span>View all projects</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="arrow-icon">
                <path d="M1.5 6H10.5M10.5 6L6.25 1.75M10.5 6L6.25 10.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </section>

          <!-- Writing Section -->
          <section class="section cascade-item">
            <SectionHeading title="Latest writing" />
            <div class="posts-list">
              {posts.slice(0, 3).map((post) => (
                <PostListItem
                  title={getTitle(post.id)}
                  date={post.data.date}
                  href={`/writing/${post.slug}`}
                  layout="row"
                />
              ))}
            </div>
            <a href="/writing" class="view-all-link">
              <span>View all writing</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="arrow-icon">
                <path d="M1.5 6H10.5M10.5 6L6.25 1.75M10.5 6L6.25 10.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </section>

          <!-- Elsewhere Section -->
          <section class="section cascade-item">
            <SectionHeading title="Elsewhere" />
            <div class="elsewhere-links">
              <p>
                See my <a href="/contact">contact</a> info. You can find me also from{' '}
                <a href="https://x.com/ronihelppi">X</a>,{' '}
                <a href="https://linkedin.com/in/ronihelppi">LinkedIn</a>, or{' '}
                <a href="https://github.com/ronijaakkola">GitHub</a>.
              </p>
              <p>Subscribe to my writing via <a href="/rss.xml">RSS</a>.</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
  <CascadeAnimation selector=".content" />
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-hero);
    color: var(--color-text-primary);
    line-height: var(--leading-normal);
    max-width: 259px;
    text-wrap: balance;
  }

  .hero-period {
    color: var(--color-text-secondary);
  }

  .bio {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
  }

  .bio-secondary {
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: var(--leading-body);
  }

  .bio-secondary a {
    color: var(--color-text-secondary);
    text-decoration-line: underline;
  }

  .bio-secondary a:hover,
  .bio-secondary a:focus-visible {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-text-primary);
  }

  .bio-highlight {
    background: linear-gradient(
      120deg,
      var(--color-text-primary),
      rgba(255, 255, 255, 0.85)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.15);
  }

  /* Sections */
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .projects-list,
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  /* View All Links */
  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-4xs);
    width: fit-content;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .view-all-link span {
    text-decoration-line: underline;
    text-decoration-color: var(--color-text-secondary);
    text-underline-offset: 2px;
    transition: text-decoration-color 100ms;
  }

  .view-all-link:hover span,
  .view-all-link:focus-visible span {
    text-decoration-color: var(--color-text-primary);
  }

  .arrow-icon {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  /* Elsewhere */
  .elsewhere-links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
    line-height: var(--leading-body);
  }

  .elsewhere-links a {
    text-decoration-line: underline;
  }

  /* Cascade Animation - global to work with child components */
  @keyframes cascade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .cascade-animate :global(.cascade-item) {
    opacity: 0;
    animation: cascade-in 0.4s ease-out forwards;
  }

  .cascade-animate :global(.cascade-item:nth-child(1)) { animation-delay: 0ms; }
  .cascade-animate :global(.cascade-item:nth-child(2)) { animation-delay: 60ms; }
  .cascade-animate :global(.cascade-item:nth-child(3)) { animation-delay: 120ms; }
  .cascade-animate :global(.cascade-item:nth-child(4)) { animation-delay: 180ms; }
  .cascade-animate :global(.cascade-item:nth-child(5)) { animation-delay: 240ms; }

  @media (prefers-reduced-motion: reduce) {
    .cascade-animate :global(.cascade-item) {
      opacity: 1;
      animation: none;
    }
  }
</style>

