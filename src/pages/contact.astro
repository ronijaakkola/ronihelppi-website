---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Roni Helppi"
  description="Get in touch with Roni Helppi. Connect on LinkedIn for design collaboration, speaking opportunities, or just to say hello."
>
  <main id="main-content" class="main">
    <div class="layout">
      <div class="prose">
        <div class="content">
          <h1 class="page-title">Contact Roni Helppi</h1>
          <div class="contact-info">
            <p>
              I'd love to hear from you. Whether you have a project in mind, want to collaborate, or just want to say hello.
            </p>
            <dl class="contact-methods">
              <!-- <div class="contact-method">
                <dt class="contact-label">Email</dt>
                <dd><a href="mailto:hello@ronihelppi.com" class="contact-link">hello@ronihelppi.com</a></dd>
              </div> -->
              <div class="contact-method">
                <dt class="contact-label">LinkedIn</dt>
                <dd><a href="https://www.linkedin.com/in/ronihelppi/" class="contact-link" target="_blank" rel="noopener noreferrer">linkedin.com/in/ronihelppi<span class="visually-hidden"> (opens in new tab)</span></a></dd>
              </div>
              <div class="contact-method">
                <dt class="contact-label">X</dt>
                <dd><a href="https://x.com/Nashtanir" class="contact-link" target="_blank" rel="noopener noreferrer">@Nashtanir<span class="visually-hidden"> (opens in new tab)</span></a></dd>
              </div>
              <div class="contact-method">
                <dt class="contact-label">GitHub</dt>
                <dd><a href="https://github.com/ronijaakkola" class="contact-link" target="_blank" rel="noopener noreferrer">github.com/ronijaakkola<span class="visually-hidden"> (opens in new tab)</span></a></dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .contact-info > p {
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
    max-width: 468px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
  }

  .contact-method {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .contact-method dd {
    margin: 0;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-secondary);
  }

  .contact-link {
    width: fit-content;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }
</style>
