---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { calculateReadTime, formatReadTime } from '../../utils/readTime';
import { getTitle } from '../../utils/title';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Derive title from id (preserves original filename)
const title = getTitle(post.id);

// Format date
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate read time
const readTime = formatReadTime(calculateReadTime(post.body));

// Get all posts for related posts lookup
const allPosts = await getCollection('posts');

// Get related posts from frontmatter (properly typed)
const relatedPostSlugs = post.data.relatedPosts || [];
const relatedPosts: CollectionEntry<'posts'>[] = relatedPostSlugs
  .map((slug: string) => allPosts.find((p) => p.slug === slug))
  .filter((p): p is CollectionEntry<'posts'> => p !== undefined);


// Get hero image from frontmatter
const heroImage = post.data.heroImage;
---

<BaseLayout title={title}>
  <main class="main">
    <div class="layout">
      <!-- Post Heading -->
      <div class="prose">
        <header class="post-header">
          <h1 class="post-title">{title}</h1>
<time class="post-meta" datetime={post.data.date.toISOString()}>{formattedDate} • {readTime}</time>
        </header>
      </div>

      {heroImage && (
        <div class="hero-image-container">
          <img src={heroImage} alt="" class="hero-image" />
        </div>
      )}

      <!-- Post Content -->
      <div class="prose">
        <article class="post-content">
          <div class="prose-content">
            <Content />
          </div>
        </article>

        {relatedPosts.length > 0 && (
          <>
            <Divider />

            <section class="related-posts">
              <SectionHeading title="Related posts" />
              <ul class="related-posts-list">
                {relatedPosts.map((relatedPost) => (
                  <li>
                    <a href={`/posts/${relatedPost.slug}`}>
                      {getTitle(relatedPost.id)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-4xs);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-hero);
    color: var(--color-text-primary);
    line-height: normal;
  }

  .post-meta {
    font-size: 18px;
    letter-spacing: -0.9px;
    color: var(--color-text-secondary);
  }

  .hero-image-container {
    width: 100%;
    margin-top: var(--gap-lg);
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    display: block;
  }

  .post-content {
    margin-top: var(--gap-lg);
  }

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    margin-top: var(--gap-section);
  }

  .related-posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body-tight);
    list-style: disc;
    padding-left: 21px;
    line-height: var(--leading-body);
  }

  .related-posts-list li {
    color: var(--color-text-primary);
  }

  .related-posts-list li::marker {
    color: var(--color-text-primary);
  }

  .related-posts-list a {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  /* Add spacing between sections */
  .prose > * + :global(.divider) {
    margin-top: var(--gap-section);
  }
</style>
